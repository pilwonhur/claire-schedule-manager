#!/usr/bin/env python3
"""claire_run — 실행 관리 (PRD §8).

  begin  --kind daily|on_demand|source_only|apply|backup --trigger <who>
         잠금 획득(BEGIN IMMEDIATE + run 행). 진행 중 실행이 있으면 그 run_id를 돌려주고
         joined=true 로 표시한다 (S11, TC13). 마지막 성공 daily가 missed_hours(26h) 이전이면
         delayed=1 (S13, TC22).
  step   --run <id> --name <step> --status ok|failed|skipped [--detail ...] [--error ...]
         단계별 상태를 run.steps 에 누적한다.
  brief  --run <id> --file briefing.md [--kind morning|on_demand|answer_ack]
         content_hash 로 중복 발송을 막고 briefing 행과 전달 기록(생성됨)을 남긴다. 0.6.0: 생성은 전송이 아니다 —
         질문 asked_count·업무 노출은 deliver --status sent 뒤에만 갱신된다.
  deliver --id N [--id M …] --status sent|failed [--message-id X …] [--error "..."] [--via message|reply]
  deliver --report KEY --status sent|failed      (그 보고의 모든 페이지)
  deliver --pending                              전송 실패·확인 없는 페이지 (claire_buttons resend 로 그 쪽만 다시)
         보고 전달 결과 (0.6.0, R8). 실패한 페이지의 업무는 "보여 줌"·"진행 확인함"으로 기록하지 않는다.
  end    --run <id> [--status ...] [--summary <json>] [--reason ...]
         필수 단계(sync·propose·brief)가 빠졌거나 실패한 단계가 있으면 partial 로 닫는다.
  status 진행 중 실행, 마지막 daily, 미실행 여부.
  missed [--notify]
         마지막 성공 daily가 missed_hours 이전인지 판정. --notify 면 outbox 에 안내문을
         하루 1건만 남긴다 (§8.4).
  checkin --slot 12:00|18:00 [--date YYYY-MM-DD]
         미등록 일정·구두 약속 확인 메시지(0.5.0). 하루·슬롯마다 한 번만 만든다(duplicate=true 면 보내지 않는다).
  checkin-mark --slot 18:00 [--date] [--message-id ID] [--result none|registered|asked|dismissed] [--refs CLR-…]
         보낸 메시지 번호·답변 결과를 남긴다.
"""

from __future__ import annotations

import argparse
import json
import sys
from datetime import timedelta
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from claire_core import (  # noqa: E402
    ClaireError, RUN_KINDS, connect, get_run, hours_between, now_dt, now_iso, parse_iso,
    run_cli, sha256_text, tx,
)
import claire_track as track  # noqa: E402

STEP_STATUSES = ["ok", "failed", "skipped"]


def _steps(row) -> list:
    return json.loads(row["steps"]) if row["steps"] else []


def _last_daily(conn):
    return conn.execute(
        "SELECT * FROM run WHERE kind='daily' AND status IN ('ok','partial') "
        "ORDER BY id DESC LIMIT 1").fetchone()


def _missed_eval(conn, cfg, now_s: str) -> dict:
    last = _last_daily(conn)
    limit = float(cfg["run"]["missed_hours"])
    if last is None:
        return {"missed": False, "reason": "성공한 daily 실행이 아직 없습니다", "last_daily_at": None,
                "hours_since": None, "limit_hours": limit}
    hrs = hours_between(last["started_at"], now_s)
    return {"missed": hrs > limit, "last_daily_at": last["started_at"], "last_daily_run_id": last["id"],
            "hours_since": round(hrs, 1), "limit_hours": limit}


def cmd_begin(args, cfg):
    conn = connect(create=False)
    now_s = now_iso(cfg)
    stale_min = int(cfg["run"]["stale_run_minutes"])
    with tx(conn):
        running = conn.execute(
            "SELECT * FROM run WHERE status='running' ORDER BY id DESC LIMIT 1").fetchone()
        if running is not None:
            age_min = hours_between(running["started_at"], now_s) * 60
            if age_min <= stale_min:
                return {"run_id": running["id"], "joined": True, "kind": running["kind"],
                        "trigger": running["trigger"], "started_at": running["started_at"],
                        "delayed": bool(running["delayed"]), "steps": _steps(running),
                        "message": "진행 중인 실행에 합류했습니다. 결과만 전달하세요 (S11)."}
            conn.execute(
                "UPDATE run SET status='aborted', finished_at=?, summary=? WHERE id=?",
                (now_s, json.dumps({"reason": f"stale: {int(age_min)}분 동안 종료되지 않음"},
                                   ensure_ascii=False), running["id"]))
        missed = _missed_eval(conn, cfg, now_s)
        delayed = 1 if (args.kind in ("daily", "on_demand") and missed["missed"]) else 0
        cur = conn.execute(
            "INSERT INTO run(kind,trigger,started_at,status,delayed,steps) VALUES(?,?,?,?,?,?)",
            (args.kind, args.trigger, now_s, "running", delayed, "[]"))
        run_id = cur.lastrowid
    out = {"run_id": run_id, "joined": False, "kind": args.kind, "trigger": args.trigger,
           "started_at": now_s, "delayed": bool(delayed)}
    if delayed:
        sched = now_dt(cfg).replace(hour=int(cfg["run"]["daily_hour"]), minute=0, second=0)
        out["delayed_note"] = (f"지연 실행(예정 {sched.strftime('%H:%M')}, "
                               f"실제 {now_dt(cfg).strftime('%H:%M')}) — 마지막 daily "
                               f"{missed['last_daily_at']} 이후 {missed['hours_since']}시간")
    return out


def cmd_step(args, cfg):
    conn = connect(create=False)
    now_s = now_iso(cfg)
    with tx(conn):
        run = get_run(conn, args.run)
        if run["status"] != "running":
            raise ClaireError("run_not_running", f"실행 {args.run}은 이미 {run['status']} 상태입니다.")
        steps = _steps(run)
        entry = {"name": args.name, "status": args.status, "at": now_s}
        if args.detail:
            try:
                entry["detail"] = json.loads(args.detail)
            except json.JSONDecodeError:
                entry["detail"] = args.detail
        if args.error:
            entry["error"] = args.error
        steps.append(entry)
        conn.execute("UPDATE run SET steps=? WHERE id=?",
                     (json.dumps(steps, ensure_ascii=False), run["id"]))
    return {"run_id": run["id"], "step": entry, "step_count": len(steps)}


def cmd_brief(args, cfg):
    conn = connect(create=False)
    now_s = now_iso(cfg)
    text = Path(args.file).read_text(encoding="utf-8") if args.file else (sys.stdin.read())
    if not text.strip():
        raise ClaireError("empty_briefing", "브리핑 본문이 비어 있습니다.")
    h = sha256_text(text.strip())
    with tx(conn):
        run = get_run(conn, args.run)
        if run["status"] != "running":
            raise ClaireError("run_not_running", f"실행 {args.run}은 이미 {run['status']} 상태입니다.")
        dup = conn.execute(
            "SELECT b.id, b.run_id, b.sent_at FROM briefing b WHERE b.content_hash=? "
            "AND substr(b.sent_at,1,10)=? ORDER BY b.id DESC LIMIT 1", (h, now_s[:10])).fetchone()
        if dup is not None:
            return {"run_id": run["id"], "duplicate": True, "briefing_id": dup["id"],
                    "message": "같은 내용의 브리핑이 오늘 이미 기록되어 있습니다. 다시 보내지 마세요."}
        import re
        item_refs = sorted(set(re.findall(r"\bCLR-\d+\b", text)))
        q_refs = sorted(set(re.findall(r"\bQ-\d+\b", text)))
        cur = conn.execute(
            "INSERT INTO briefing(run_id,kind,content_hash,item_refs,question_refs,sent_at,delivery) "
            "VALUES(?,?,?,?,?,?,?)",
            (run["id"], args.kind, h, json.dumps(item_refs), json.dumps(q_refs), now_s, "generated"))
        # 전달 기록 한 쪽(본문 그대로). claire_buttons build --record brief --briefing <id> 가 버튼 페이지로 바꾼다.
        rec = track.register_delivery(conn, cfg, "brief", [{"message": text.strip(), "components": None,
                                                            "numbers": item_refs}],
                                      now_s, report_key=f"brief:{cur.lastrowid}", question_refs=q_refs)
        steps = _steps(run)
        steps.append({"name": "brief", "status": "ok", "at": now_s,
                      "detail": {"briefing_id": cur.lastrowid, "chars": len(text), "report_key": rec["report_key"]}})
        conn.execute("UPDATE run SET steps=? WHERE id=?",
                     (json.dumps(steps, ensure_ascii=False), run["id"]))
    return {"run_id": run["id"], "duplicate": False, "briefing_id": cur.lastrowid,
            "content_hash": h, "item_refs": item_refs, "question_refs": q_refs,
            "report_key": rec["report_key"], "delivery_id": rec["messages"][0]["delivery_id"],
            "message": "브리핑을 기록했습니다(생성). claire_buttons build --file … --record brief --briefing "
                       f"{cur.lastrowid} 로 버튼 페이지를 만들어 보내고, 쪽마다 claire_run deliver 로 전송 결과를 남기세요."}


def _mark_questions_asked(conn, cfg, q_refs: list[str], now_s: str) -> list[dict]:
    """(0.6.0) claire_track.mark_questions_asked 로 옮겼다. 질문은 전달 성공(deliver --status sent) 때만 센다."""
    return track.mark_questions_asked(conn, cfg, q_refs, now_s)


def cmd_deliver(args, cfg):
    """보고 전달 결과 (R8). sent → 그 쪽 업무 노출·진행 확인·질문 기록. failed → 아무것도 기록하지 않고 재전송 대상."""
    conn = connect(create=False)
    now = now_dt(cfg); now_s = now.isoformat()
    if args.pending:
        issues = track.delivery_issues(conn, cfg, now)
        issues["message"] = (f"다시 보낼 쪽 {issues['count']}개 — claire_buttons resend 로 그 쪽만 보내세요"
                             if issues["count"] else "전송 실패·확인 없는 쪽이 없습니다.")
        return issues
    if not args.status:
        raise ClaireError("bad_args", "--status sent|failed 가 필요합니다 (또는 --pending)")
    ids = list(args.id or [])
    if args.report:
        ids += [r["id"] for r in conn.execute("SELECT id FROM delivery WHERE report_key=? AND status<>'superseded' ORDER BY page",
                                              (args.report,))]
    if not ids:
        raise ClaireError("bad_args", "--id 또는 --report 가 필요합니다")
    with tx(conn):
        r = track.mark_delivery(conn, cfg, ids, args.status, now_s, message_ids=args.message_id, error=args.error,
                                via=args.via)
    if args.status == "sent":
        r["message"] = (f"전송 기록: {len(r['sent'])}쪽 · 업무 {len(r['exposed'])}건 노출"
                        + (f" · 진행 확인 {len(r['asked'])}건" if r["asked"] else "")
                        + (f" · 질문 {len(r['questions'])}건" if r["questions"] else ""))
    else:
        n = sum(len(f["items"]) for f in r["failed"])
        r["message"] = (f"전송 실패 {len(r['failed'])}쪽 기록 — 그 쪽의 업무 {n}건은 전달된 것으로 보지 않습니다. "
                        "claire_buttons resend 로 그 쪽만 다시 보내세요.")
    return r


def _compute_status(cfg, run, steps) -> tuple[str, list[str]]:
    reasons = []
    failed = [s["name"] for s in steps if s.get("status") == "failed"]
    if failed:
        reasons.append("실패 단계: " + ", ".join(failed))
    if run["kind"] in ("daily", "on_demand"):
        done = {s["name"] for s in steps if s.get("status") == "ok"}
        missing = [s for s in cfg["run"]["required_steps"] if s not in done]
        if missing:
            reasons.append("누락 단계: " + ", ".join(missing))
    return ("partial" if reasons else "ok"), reasons


def cmd_end(args, cfg):
    conn = connect(create=False)
    now_s = now_iso(cfg)
    backup = None
    if args.backup:
        import subprocess, os
        here = Path(__file__).resolve().parent
        proc = subprocess.run([sys.executable, str(here / "claire_check"), "backup"], capture_output=True, text=True,
                              env=dict(os.environ))
        try:
            b = json.loads(proc.stdout)
        except json.JSONDecodeError:
            b = {"ok": False, "error": {"message": proc.stderr[-300:]}}
        backup = {"ok": bool(b.get("ok")), "dir": b.get("backup_dir"), "error": (b.get("error") or {}).get("message")}
        with tx(conn):
            run = get_run(conn, args.run)
            steps = _steps(run)
            steps.append({"name": "backup", "status": "ok" if backup["ok"] else "failed", "at": now_iso(cfg),
                          "detail": backup})
            conn.execute("UPDATE run SET steps=? WHERE id=?", (json.dumps(steps, ensure_ascii=False), run["id"]))
    with tx(conn):
        run = get_run(conn, args.run)
        if run["status"] != "running":
            raise ClaireError("run_not_running", f"실행 {args.run}은 이미 {run['status']} 상태입니다.")
        steps = _steps(run)
        status, reasons = _compute_status(cfg, run, steps)
        if args.status:
            if args.status == "ok" and reasons:
                raise ClaireError("cannot_close_ok",
                                  "필수 단계가 빠졌거나 실패한 단계가 있어 ok 로 닫을 수 없습니다.",
                                  reasons=reasons)
            status = args.status
        if args.reason:
            reasons.append(args.reason)
        summary = {}
        if args.summary:
            try:
                summary = json.loads(args.summary)
            except json.JSONDecodeError:
                raise ClaireError("bad_summary", "--summary 는 JSON 이어야 합니다.")
        summary["reasons"] = reasons
        summary["duration_seconds"] = int((parse_iso(now_s) - parse_iso(run["started_at"])).total_seconds())
        conn.execute("UPDATE run SET status=?, finished_at=?, summary=? WHERE id=?",
                     (status, now_s, json.dumps(summary, ensure_ascii=False), run["id"]))
    return {"run_id": run["id"], "status": status, "finished_at": now_s, "reasons": reasons,
            "steps": steps, "summary": summary, "backup": backup}


def cmd_status(args, cfg):
    conn = connect(create=False)
    now_s = now_iso(cfg)
    running = conn.execute("SELECT * FROM run WHERE status='running' ORDER BY id DESC LIMIT 1").fetchone()
    last_by_kind = {}
    for k in RUN_KINDS:
        r = conn.execute("SELECT * FROM run WHERE kind=? ORDER BY id DESC LIMIT 1", (k,)).fetchone()
        if r:
            last_by_kind[k] = {"run_id": r["id"], "status": r["status"], "started_at": r["started_at"],
                               "finished_at": r["finished_at"], "delayed": bool(r["delayed"])}
    sync = [dict(r) for r in conn.execute("SELECT * FROM sync_state ORDER BY platform, account")]
    return {"now": now_s,
            "running": None if running is None else {
                "run_id": running["id"], "kind": running["kind"], "trigger": running["trigger"],
                "started_at": running["started_at"], "steps": _steps(running)},
            "last_by_kind": last_by_kind, "missed": _missed_eval(conn, cfg, now_s),
            "sync_state": sync}


def cmd_missed(args, cfg):
    conn = connect(create=False)
    now_s = now_iso(cfg)
    res = _missed_eval(conn, cfg, now_s)
    hour = int(cfg["run"]["daily_hour"])
    res["message"] = (f"{hour:02d}:00 점검이 실행되지 않았습니다 (마지막 성공 {res['last_daily_at']}). "
                      "'지금 전체 점검'으로 요청해 주세요." if res["missed"] else None)
    if res["missed"] and args.notify:
        key = f"discord.notice:missed:{now_s[:10]}"
        with tx(conn):
            exists = conn.execute("SELECT id, status FROM outbox WHERE dedupe_key=?", (key,)).fetchone()
            if exists is None:
                conn.execute(
                    "INSERT INTO outbox(op,item_id,payload,dedupe_key,requires_confirm,status,created_at) "
                    "VALUES('discord.notice',NULL,?,?,0,'pending',?)",
                    (json.dumps({"text": res["message"]}, ensure_ascii=False), key, now_s))
                res["queued"] = True
            else:
                res["queued"] = False
                res["already_queued_id"] = exists["id"]
    return res


def _slot(value: str) -> str:
    v = value.strip()
    if v.isdigit():
        v = f"{int(v):02d}:00"
    if len(v) == 4 and v[1] == ":":
        v = "0" + v
    if len(v) != 5 or v[2] != ":":
        raise ClaireError("bad_slot", f"--slot 은 HH:MM (예: 12:00, 18:00): {value}")
    return v


def cmd_checkin(args, cfg):
    """12:00·18:00 미등록 일정 확인 (0.5.0). 판단 없이 메시지 재료만 만든다. 답은 Claire 가 SKILL §4.2 대로 처리한다."""
    conn = connect(create=False)
    now = now_dt(cfg); now_s = now.isoformat()
    day = args.date or now.strftime("%Y-%m-%d")
    slot = _slot(args.slot)
    with tx(conn):
        row = conn.execute("SELECT * FROM checkin WHERE day=? AND slot=?", (day, slot)).fetchone()
        if row is not None:
            return {"duplicate": True, "day": day, "slot": slot, "created_at": row["created_at"],
                    "message": "이 시간대 확인은 오늘 이미 보냈습니다. 다시 보내지 마세요."}
        conn.execute("INSERT INTO checkin(day,slot,created_at) VALUES(?,?,?)", (day, slot, now_s))
    issues = track.delivery_issues(conn, cfg, now)
    today_new = [dict(r) for r in conn.execute(
        "SELECT DISTINCT i.ref, i.title FROM activity_log a JOIN item i ON i.id=a.item_id WHERE a.action='create' "
        "AND substr(a.created_at,1,10)=? AND i.status NOT IN ('captured','cancelled') ORDER BY i.id", (day,))]
    lines = [f"[{slot} 확인] 오늘 새로 생긴 일정이나 구두 약속 중 아직 등록하지 않은 것이 있나요?",
             "있으면 이 메시지에 답장으로 적어 주세요. 예: `금요일 3시 김 교수 면담`, `다음 주 화요일까지 추천서`.",
             "날짜·시각이 빠지면 여쭙고, 이미 있는 일정과 겹치면 알려 드립니다."]
    if today_new:
        shown = ", ".join(f"{r['ref']} {r['title']}" for r in today_new[:5])
        lines.append(f"오늘 등록된 것: {shown}" + (f" 외 {len(today_new) - 5}건" if len(today_new) > 5 else ""))
    text = "\n".join(lines)
    components = {"reusable": True, "text": lines[0], "blocks": [
        {"type": "text", "text": "\n".join(lines[1:])},
        {"type": "actions", "buttons": [{"label": f"{slot} 미등록 일정 없음", "style": "secondary"}]}]}
    to = (cfg.get("discord") or {}).get("send_to")
    with tx(conn):
        rec = track.register_delivery(conn, cfg, "checkin", [{"message": text, "components": components, "numbers": []}],
                                      now_s, report_key=f"checkin:{day}@{slot}")
    out = {"duplicate": False, "day": day, "slot": slot, "checkin": f"{day}@{slot}", "message": text,
           "components": components, "today_registered": today_new, "send_to": to,
           "delivery_id": rec["messages"][0]["delivery_id"], "delivery_issues": issues,
           "send_with": "message 도구로 to=send_to, message·components 를 보낸다(cron 턴에는 대화 중인 채널이 없으니 반드시 "
                        "send_to). 보낸 뒤 claire_run deliver --id <delivery_id> --status sent --message-id <id> 와 "
                        "checkin-mark --message-id. delivery_issues 가 있으면 claire_buttons resend 로 그 쪽만 먼저 다시 보낸다."}
    if not to:
        out["send_to_note"] = ("config discord.send_to 가 없어 보낼 채널을 모릅니다(0.6.0 전의 '전송 대상 미지정' 실패). "
                               "claire_check channel-target --write 로 설정하세요.")
    return out


def cmd_checkin_mark(args, cfg):
    conn = connect(create=False)
    now = now_dt(cfg); now_s = now.isoformat()
    day = args.date or now.strftime("%Y-%m-%d")
    slot = _slot(args.slot)
    with tx(conn):
        row = conn.execute("SELECT * FROM checkin WHERE day=? AND slot=?", (day, slot)).fetchone()
        if row is None:
            raise ClaireError("checkin_not_found", f"{day} {slot} 확인 기록이 없습니다")
        sets, vals = [], []
        if args.message_id:
            sets.append("message_id=?"); vals.append(args.message_id)
        if args.result:
            result = {"result": args.result, "refs": args.refs or []}
            sets += ["answered_at=?", "result=?"]; vals += [now_s, json.dumps(result, ensure_ascii=False)]
        if sets:
            conn.execute(f"UPDATE checkin SET {', '.join(sets)} WHERE id=?", (*vals, row["id"]))
    return {"day": day, "slot": slot, "message_id": args.message_id or row["message_id"], "result": args.result,
            "refs": args.refs or []}


def build_parser():
    p = argparse.ArgumentParser(prog="claire_run", description="Claire 실행 관리 (PRD §8)")
    sub = p.add_subparsers(dest="cmd")
    b = sub.add_parser("begin", help="실행 시작·잠금")
    b.add_argument("--kind", choices=RUN_KINDS, required=True)
    b.add_argument("--trigger", required=True, help="cron | user:<message id> | launchd")
    b.set_defaults(fn=cmd_begin)
    s = sub.add_parser("step", help="단계 기록")
    s.add_argument("--run", type=int, required=True)
    s.add_argument("--name", required=True)
    s.add_argument("--status", choices=STEP_STATUSES, default="ok")
    s.add_argument("--detail")
    s.add_argument("--error")
    s.set_defaults(fn=cmd_step)
    br = sub.add_parser("brief", help="브리핑 기록 (중복 발송 방지)")
    br.add_argument("--run", type=int, required=True)
    br.add_argument("--file")
    br.add_argument("--kind", choices=["morning", "on_demand", "answer_ack"], default="morning")
    br.set_defaults(fn=cmd_brief)
    e = sub.add_parser("end", help="실행 종료")
    e.add_argument("--run", type=int, required=True)
    e.add_argument("--status", choices=["ok", "partial", "failed", "aborted"])
    e.add_argument("--summary")
    e.add_argument("--reason")
    e.add_argument("--backup", action="store_true", help="종료 전에 claire_check backup 실행 (§10 쓰기 발생일 1회)")
    e.set_defaults(fn=cmd_end)
    st = sub.add_parser("status", help="실행 상태")
    st.set_defaults(fn=cmd_status)
    m = sub.add_parser("missed", help="미실행 감지")
    m.add_argument("--notify", action="store_true")
    m.set_defaults(fn=cmd_missed)
    ci = sub.add_parser("checkin", help="12:00·18:00 미등록 일정 확인 메시지")
    ci.add_argument("--slot", required=True); ci.add_argument("--date")
    ci.set_defaults(fn=cmd_checkin)
    cm = sub.add_parser("checkin-mark", help="확인 메시지 번호·답변 결과 기록")
    cm.add_argument("--slot", required=True); cm.add_argument("--date"); cm.add_argument("--message-id")
    cm.add_argument("--result", choices=["none", "registered", "asked", "dismissed"])
    cm.add_argument("--refs", nargs="*")
    cm.set_defaults(fn=cmd_checkin_mark)
    dv = sub.add_parser("deliver", help="보고 전달 결과 기록 (0.6.0)")
    dv.add_argument("--id", type=int, action="append", help="delivery_id (여러 번)")
    dv.add_argument("--report", help="report_key — 그 보고의 모든 쪽")
    dv.add_argument("--status", choices=["sent", "failed"])
    dv.add_argument("--message-id", action="append", help="Discord 메시지 번호 (--id 순서대로)")
    dv.add_argument("--error")
    dv.add_argument("--via", choices=["message", "reply"], default=None)
    dv.add_argument("--pending", action="store_true", help="전송 실패·확인 없는 쪽 목록")
    dv.set_defaults(fn=cmd_deliver)
    return p


if __name__ == "__main__":
    run_cli(build_parser, lambda args, cfg: args.fn(args, cfg))
