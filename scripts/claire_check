#!/usr/bin/env python3
"""claire_check — 초기화·무결성·백업·복구·연결 진단 (PRD §10, §11, §13 1단계).

  init                      데이터 디렉터리·스키마·config.json 생성 (멱등). 0.9.0: 데이터 루트 표지·위치 기록
  integrity [--strict]      무결성 검사 (§10)
  backup [--out] [--no-mirror]                    백업 루트(기본 ~/SecretaryBackups/schedule)에 <시각>/ 백업
  restore-test --from <backup dir 또는 db 파일>   건수·해시·파일 해시 대조 (TC20), 다시 가려야 할 항목 수
  restore --from <backup dir> --to <빈 폴더>        격리 복원 (가림 재적용·검증). 운영 위치에는 복원하지 않는다
  doctor [--offline] [--format text]              §4.3 확인 사항 실측
  channel-prompt [--guild --channel]              Claire 채널 systemPrompt 패치 JSON (| openclaw config patch --stdin)
  channel-target [--channel ID] [--write]         cron 턴에서 보낼 채널(discord.send_to) 확인·설정 (0.6.0)
  version [--remote]                              설치 버전·설치 출처, --remote 면 GitHub 최신 릴리스와 비교
  calibrate                 5단계 (표본이 없으면 근거 부족만 보고)
"""

from __future__ import annotations

import argparse
import json
import os
import platform
import shutil
import sqlite3
import subprocess
import sys
from datetime import datetime
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "connectors"))
from claire_core import (  # noqa: E402
    CLAIRE_VERSION, COUNT_TABLES, DB_NAME, DEFAULT_CONFIG,
    SCHEMA_VERSION, ClaireError, atomic_write_text, connect, content_hash, data_dir, db_path,
    is_synced_location, now_iso, run_cli, sha256_file, table_counts, tz_of,
)
import claire_paths  # noqa: E402
import claire_data  # noqa: E402
from claire_data import run_integrity  # noqa: E402,F401  (0.9.0: claire_data 로 옮김 — 임의 데이터 루트 검사)

# 0.9.0: backups/ 는 데이터 폴더가 아니라 백업 루트(claire_paths.backup_root)에 둔다
DATA_SUBDIRS = ("secrets", "raw", "attachments", "exports", "logs")
SECRETS_POLICY = ("인증정보(secrets/)는 백업에 넣지 않는다. 복원 사본에는 토큰이 없으므로 google_api.py authorize 로 다시 "
                  "발급하거나, 데이터 위치 이전(claire_relocate)의 보호 복사(700/600, 값 출력 없음)로만 옮긴다.")
REPO_URL = "https://github.com/pilwonhur/claire-schedule-manager.git"
INSTALL_INFO = Path(__file__).resolve().parent.parent / "INSTALL_INFO.json"    # install.sh 가 쓴다
CHECKIN_EXPR = "0 12,18 * * *"
CHANNEL_PROMPT_FILE = Path(__file__).resolve().parent.parent / "references" / "discord-channel-prompt.txt"
CHANNEL_PROMPT_MARKER = "message(action=send)"


def channel_prompt_text() -> str:
    """Claire 채널에 넣는 OpenClaw 채널별 systemPrompt 원문 (v0.4.5, references/discord-channel-prompt.txt)."""
    return CHANNEL_PROMPT_FILE.read_text(encoding="utf-8").strip()


def find_claire_channels(guilds: dict) -> list[dict]:
    """OpenClaw `channels.discord.accounts.claire.guilds` 에서 enabled 채널을 [{guild, channel, systemPrompt}] 로 편다."""
    found = []
    for gid, g in (guilds or {}).items():
        for cid, c in ((g or {}).get("channels") or {}).items():
            if (c or {}).get("enabled", True):
                found.append({"guild": str(gid), "channel": str(cid), "systemPrompt": (c or {}).get("systemPrompt")})
    return found


def channel_prompt_status(channels: list[dict], expected: str) -> tuple[str, str]:
    """(status, detail). 채널 하나라도 원문과 같으면 ok, 문구는 있지만 다르면 warn(구버전), 없으면 warn."""
    if not channels:
        return "warn", "OpenClaw Claire 계정에 enabled 된 Discord 채널이 없음"
    same = [c for c in channels if (c["systemPrompt"] or "").strip() == expected]
    if same:
        return "ok", f"채널 {same[0]['channel']} systemPrompt = references/discord-channel-prompt.txt (버튼 응답의 message 도구 허용 예외)"
    partial = [c for c in channels if CHANNEL_PROMPT_MARKER in (c["systemPrompt"] or "")]
    if partial:
        return "warn", f"채널 {partial[0]['channel']} systemPrompt 가 원문과 다름(구버전?) → 다시 적용"
    return "warn", ("채널 systemPrompt 없음 → OpenClaw 그룹 지침이 message 도구를 첨부 전용으로 제한해 "
                    "번호 버튼 대신 텍스트로 답하는 퇴행이 생긴다(2026-09-16 실측)")


def _open(path) -> sqlite3.Connection:
    conn = sqlite3.connect(path)
    conn.row_factory = sqlite3.Row
    return conn


# --------------------------------------------------------------------------
# init
# --------------------------------------------------------------------------

# 기본값을 바꾼 설정 (0.7.1). init 이 예전 기본값을 config.json 에 적어 두었기 때문에(새 키 채우기) 기본값만 바꾸면 기존 설치에는
# 적용되지 않았다(0.7.0 점검: Tasks 승인 대기 4건, 보류 7일). 값이 **예전 기본값 그대로일 때만** 한 번 새 값으로 바꾼다.
# 교수님이 바꾼 값은 두고, 한 번 바꾼 뒤 교수님이 되돌리면 다시 바꾸지 않는다(config.json 의 _migrated_defaults 에 기록).
CHANGED_DEFAULTS = [
    ("apply.obsidian_add_task", "confirm_unless_directed", "always", "0.7.0"),   # Tasks 승인 없이 자동 (2026-09-29 결정)
    ("tracking.hold_default_days", 7, 3, "0.7.0"),                               # 보류 재확인 기본 3일
]


def _migrate_defaults(user: dict) -> list[dict]:
    done = user.setdefault("_migrated_defaults", [])
    changed = []
    for dotted, old, new, ver in CHANGED_DEFAULTS:
        tag = f"{dotted}@{ver}"
        if tag in done:
            continue
        *parents, leaf = dotted.split(".")
        node = user
        for k in parents:
            node = node.get(k) if isinstance(node, dict) else None
        if isinstance(node, dict) and leaf in node and node[leaf] == old:
            node[leaf] = new
            changed.append({"key": dotted, "from": old, "to": new, "version": ver})
        done.append(tag)
    return changed


def _merge_config_file(path: Path) -> list[str]:
    """config.json 이 없으면 기본값으로 만들고, 있으면 새 키만 채운다. 사용자 값은 보존."""
    if not path.exists():
        atomic_write_text(path, json.dumps(DEFAULT_CONFIG, ensure_ascii=False, indent=2) + "\n")
        return ["<created>"]
    user = json.loads(path.read_text(encoding="utf-8"))
    added: list[str] = []

    def merge(defaults, current, prefix=""):
        for k, v in defaults.items():
            if k not in current:
                current[k] = v
                added.append(prefix + k)
            elif isinstance(v, dict) and isinstance(current[k], dict):
                merge(v, current[k], prefix + k + ".")

    before = json.dumps(user, sort_keys=True)
    migrated = _migrate_defaults(user)          # 먼저: 새로 채우는 키는 이미 새 기본값이다
    merge(DEFAULT_CONFIG, user)
    added += [f"{m['key']}: {m['from']} → {m['to']} (기본값 변경 {m['version']})" for m in migrated]
    if json.dumps(user, sort_keys=True) != before:
        atomic_write_text(path, json.dumps(user, ensure_ascii=False, indent=2) + "\n")
    return added


def cmd_init(args, cfg):
    """데이터베이스와 디렉터리를 만든다. 이미 있으면 그대로 둔다 (멱등).
    0.9.0: 위치는 claire_paths 가 정한다. 이전 작업 중·은퇴한 위치·두 위치 충돌·위치 기록 대상 없음이면 아무것도 만들지 않는다.
    위치 기록이 없으면(처음 설치·0.9.0 으로 처음 업데이트) 지금 위치를 기록해 예약 실행·수동 실행이 같은 장부를 쓰게 한다."""
    try:
        loc = claire_paths.require_usable()
    except claire_paths.LocationError as e:
        raise ClaireError(e.code, e.message, fix=e.fix, **e.extra) from None
    d = loc.path
    existed = (d / DB_NAME).exists()
    d.mkdir(parents=True, exist_ok=True, mode=0o700)
    for sub in DATA_SUBDIRS:
        (d / sub).mkdir(parents=True, exist_ok=True)
    os.chmod(d / "secrets", 0o700)
    added = _merge_config_file(d / "config.json")
    conn = connect(create=True)
    adopt = (loc.pointer or {}).get("root_id") if loc.source == "pointer" else None
    marker = claire_paths.ensure_marker(d, root_id=adopt)
    pointer_written = False
    if loc.source in ("legacy", "default", "moved") and not loc.pointer:   # moved: 잃어버린 위치 기록을 은퇴 표지로 되살림
        claire_paths.write_pointer(d, marker.get("root_id"), reason=f"init:{loc.source}")
        pointer_written = True
    version = conn.execute("SELECT value FROM meta WHERE key='schema_version'").fetchone()
    synced = is_synced_location(d)
    # 0.6.1: 설치·업그레이드 때 바로 기존 업무 중요도 소급 분류(한 번)와 자동 마감 표시 보정 (다음 06:00 을 기다리지 않는다)
    from claire_core import load_config, tx
    import claire_track
    with tx(conn):
        upkeep = claire_track.upkeep(conn, load_config(), now_iso(cfg))
    return {
        "data_dir": str(d), "db": str(db_path()), "created": not existed,
        "schema_version": int(version["value"]), "claire_version": CLAIRE_VERSION,
        "config_added_keys": added, "counts": table_counts(conn), "upkeep": upkeep,
        "location": {"source": loc.source, "source_label": claire_paths.SOURCE_LABELS.get(loc.source),
                     "root_id": marker.get("root_id"), "pointer_written": pointer_written,
                     "warnings": loc.warnings},
        "warning": (f"데이터 디렉터리가 {synced} 동기화 폴더 안에 있습니다. §4.2 위반입니다."
                    if synced else None),
        "message": "데이터베이스를 만들었습니다." if not existed else "이미 초기화되어 있습니다. 변경 없음.",
    }


# --------------------------------------------------------------------------
# integrity (§10)
# --------------------------------------------------------------------------

def cmd_integrity(args, cfg):
    conn = connect(create=False)
    result = run_integrity(conn, cfg)
    result["data_dir"] = str(data_dir())
    result["db"] = str(db_path())
    if not result["healthy"] and args.strict:
        raise ClaireError("integrity_failed", f"무결성 문제 {result['problem_count']}건",
                          problems=result["problems"])
    return result


# --------------------------------------------------------------------------
# backup / restore-test (§10, TC20)
# --------------------------------------------------------------------------

def _snapshot(src_conn, dest: Path):
    dest.parent.mkdir(parents=True, exist_ok=True)
    target = sqlite3.connect(dest)
    try:
        src_conn.backup(target)
    finally:
        target.close()


def _copy_tree(src: Path, dst: Path) -> int:
    if not src.exists():
        return 0
    n = 0
    for p in src.rglob("*"):
        if p.is_file() and ".incoming" not in p.parts and p.name != ".DS_Store":
            rel = p.relative_to(src)
            out = dst / rel
            out.parent.mkdir(parents=True, exist_ok=True)
            try:
                os.link(p, out)
            except OSError:
                shutil.copy2(p, out)
            n += 1
    return n


def _prune(backup_root: Path, cfg) -> list[str]:
    """보존 정책(일 7·주 4·월 12)은 Claire 정기 백업에만 적용한다 (0.9.0). 이전용 백업, 업그레이드 전 사본,
    다른 시스템이 같은 루트에 둔 사본(예: 사전 백업 20261024T224649)은 지우지 않는다."""
    dirs = sorted([d for d in backup_root.iterdir() if d.is_dir() and d.name[0].isdigit()
                   and claire_data.is_prunable_backup(d)], reverse=True)
    keep, seen_w, seen_m = set(), set(), set()
    ret = cfg["backup_retention"]
    for i, d in enumerate(dirs):
        try:
            when = datetime.strptime(d.name[:15], "%Y%m%dT%H%M%S")
        except ValueError:
            keep.add(d)
            continue
        if i < ret["daily"]:
            keep.add(d)
        wk = when.strftime("%G-W%V")
        if wk not in seen_w and len(seen_w) < ret["weekly"]:
            seen_w.add(wk); keep.add(d)
        mo = when.strftime("%Y-%m")
        if mo not in seen_m and len(seen_m) < ret["monthly"]:
            seen_m.add(mo); keep.add(d)
    removed = []
    for d in dirs:
        if d not in keep:
            shutil.rmtree(d, ignore_errors=True)
            removed.append(d.name)
    return removed


def _backup_dest(root: Path, stamp: str) -> Path:
    """같은 초에 두 번 백업해도 섞이지 않게 (<시각>, <시각>-2, …)."""
    dest, n = root / stamp, 1
    while dest.exists():
        n += 1
        dest = root / f"{stamp}-{n}"
    return dest


def _hash_tree(base: Path, rels) -> dict:
    return {rel: sha256_file(base / rel) for rel in rels}


def cmd_backup(args, cfg):
    conn = connect(create=False)
    ts = now_iso(cfg)
    stamp = datetime.fromisoformat(ts).strftime("%Y%m%dT%H%M%S")
    root = claire_paths.backup_root(cfg.get("backup_root"), args.out)
    root.mkdir(parents=True, exist_ok=True)
    dest = _backup_dest(root, stamp)
    dest.mkdir(mode=0o700)

    _snapshot(conn, dest / DB_NAME)
    here = Path(__file__).resolve().parent
    env = dict(os.environ, CLAIRE_DATA_DIR=str(data_dir()))
    subprocess.run([sys.executable, str(here / "claire_export"), "json",
                    "--out", str(dest / "claire-export.json")], check=True,
                   capture_output=True, env=env)
    subprocess.run([sys.executable, str(here / "claire_export"), "md",
                    "--out", str(dest / "markdown")], check=True, capture_output=True, env=env)
    n_att = _copy_tree(data_dir() / "attachments", dest / "attachments")
    n_raw = _copy_tree(data_dir() / "raw", dest / "raw")
    # 가림 목록은 합집합으로만 늘린다 (옛 백업으로 되돌려도 지운 개인정보를 다시 들이지 않게, 0.9.0)
    entries = claire_data.redaction_entries(conn)
    n_red = claire_data.merge_redaction_manifest(root / claire_data.REDACTION_MANIFEST, entries, ts)
    shutil.copy2(root / claire_data.REDACTION_MANIFEST, dest / claire_data.REDACTION_MANIFEST)
    # config 사본 (비밀값 없음). secrets/ 는 복사하지 않는다.
    cfg_path = data_dir() / "config.json"
    if cfg_path.exists():
        shutil.copy2(cfg_path, dest / "config.json")
    rels = [p.relative_to(dest).as_posix() for sub in ("attachments", "raw") for p in (dest / sub).rglob("*") if p.is_file()]
    if (dest / "config.json").exists():
        rels.append("config.json")
    claire_data.write_sha256sums(dest, _hash_tree(dest, rels))

    snap = _open(dest / DB_NAME)
    verify = run_integrity(snap, root=dest)
    counts = table_counts(snap)
    chash = content_hash(snap)
    fp = claire_data.data_fingerprint(snap)
    snap.close()
    marker = claire_paths.read_marker(data_dir()) or {}
    manifest = {"kind": "claire-backup", "created_at": ts, "claire_version": CLAIRE_VERSION, "schema_version": SCHEMA_VERSION,
                "data_dir": str(data_dir()), "data_root_id": marker.get("root_id"),
                "counts": counts, "content_hash": chash, "fingerprint": fp["sha256"], "refs": fp["refs"],
                "attachments": n_att, "raw_files": n_raw, "file_hashes": len(rels),
                "db_sha256": sha256_file(dest / DB_NAME),
                # snapshot_healthy 는 운영 상태(예: outbox 실패 1건)까지 포함한다. 장부·파일 자체는 storage_ok 로 본다 (0.9.0)
                "snapshot_healthy": verify["healthy"], "storage_ok": verify["storage_ok"],
                "operational_problems": verify["operational_problems"],
                "excludes": ["secrets/", "backups/", "skill-prev/"], "secrets_policy": SECRETS_POLICY}
    atomic_write_text(dest / "manifest.json", json.dumps(manifest, ensure_ascii=False, indent=2))

    removed = _prune(root, cfg)
    mirrored = None
    if not args.no_mirror and cfg.get("backup_mirror"):
        mirror = Path(cfg["backup_mirror"]).expanduser()
        try:
            mirror.mkdir(parents=True, exist_ok=True)
            mdest = mirror / dest.name
            if mdest.exists():
                shutil.rmtree(mdest)
            shutil.copytree(dest, mdest)
            claire_data.merge_redaction_manifest(mirror / claire_data.REDACTION_MANIFEST, entries, ts)
            _prune(mirror, cfg)
            mirrored = str(mdest)
        except OSError as e:
            mirrored = f"실패: {e}"
    return {"backup_dir": str(dest), "backup_root": str(root), "manifest": manifest, "pruned": removed,
            "mirror": mirrored, "redaction_entries": n_red}


def _redaction_sources(src: Path, cfg) -> list:
    """복원 때 다시 적용할 가림 목록: 백업 안 사본, 백업이 있던 루트, 지금 백업 루트, 미러 (합집합)."""
    paths = []
    if src.is_dir():
        paths += [src / claire_data.REDACTION_MANIFEST, src.parent / claire_data.REDACTION_MANIFEST]
    paths.append(claire_paths.backup_root(cfg.get("backup_root")) / claire_data.REDACTION_MANIFEST)
    if cfg.get("backup_mirror"):
        paths.append(Path(cfg["backup_mirror"]).expanduser() / claire_data.REDACTION_MANIFEST)
    entries = claire_data.read_redaction_files(*paths)
    try:                                   # 지금 장부에 있는 가림도 (목록 파일이 없던 시절의 가림)
        if db_path().exists() and not claire_paths.resolve().blockers:
            live = claire_data.open_ro(db_path())
            seen = {(e.get("kind"), e.get("id")) for e in entries}
            entries += [e for e in claire_data.redaction_entries(live) if (e["kind"], e["id"]) not in seen]
            live.close()
    except sqlite3.Error:
        pass
    return entries


def _verify_backup_files(src: Path) -> dict:
    sums = claire_data.read_sha256sums(src) if src.is_dir() else {}
    missing, bad = [], []
    for rel, h in sums.items():
        p = src / rel
        if not p.exists():
            missing.append(rel)
        elif sha256_file(p) != h:
            bad.append(rel)
    return {"listed": len(sums), "missing": missing, "hash_mismatch": bad,
            "ok": (not missing and not bad) if sums else None}


def cmd_restore_test(args, cfg):
    """백업만으로 새 DB를 만들고 건수·해시가 일치하는지 대조한다 (TC20)."""
    src = Path(getattr(args, "from_path")).expanduser()
    db_file = src / DB_NAME if src.is_dir() else src
    if not db_file.exists():
        raise ClaireError("backup_missing", f"백업 DB가 없습니다: {db_file}")
    manifest = None
    if src.is_dir() and (src / "manifest.json").exists():
        manifest = json.loads((src / "manifest.json").read_text(encoding="utf-8"))
    # secrets 가 백업에 섞여 있지 않은지
    secrets_leaked = src.is_dir() and any(p.name == "secrets" for p in src.rglob("secrets"))

    restored = _open(":memory:")
    src_conn = sqlite3.connect(db_file)
    src_conn.backup(restored)
    src_conn.close()
    r_counts = table_counts(restored)
    r_hash = content_hash(restored)
    integ = run_integrity(restored, root=src if src.is_dir() else src.parent)
    pending = claire_data.pending_redactions(restored, _redaction_sources(src, cfg))

    live = {}
    if db_path().exists() and not claire_paths.resolve().blockers:
        lconn = connect(create=False)
        live = {"counts": table_counts(lconn), "content_hash": content_hash(lconn)}
    diff = {t: {"live": live["counts"][t], "restored": r_counts[t]}
            for t in COUNT_TABLES if live and live["counts"][t] != r_counts[t]}
    manifest_match = None
    if manifest:
        manifest_match = (manifest.get("counts") == r_counts and manifest.get("content_hash") == r_hash)
    return {
        "source": str(db_file), "restored_counts": r_counts, "restored_content_hash": r_hash,
        "restored_healthy": integ["healthy"], "restored_storage_ok": integ["storage_ok"],
        "restored_problems": integ["problems"],
        "manifest_match": manifest_match, "files": _verify_backup_files(src),
        "redactions_to_reapply": len(pending),
        "live_match": (not diff and live.get("content_hash") == r_hash) if live else None,
        "live_diff": diff, "secrets_included": bool(secrets_leaked),
        "db_in_synced_folder": is_synced_location(db_path()),
        "note": "live 차이는 백업 이후 추가된 기록일 수 있습니다. manifest_match 가 복구 성공의 기준입니다."
                + (" 이 백업에는 그 뒤 가린 항목이 있어 복원하면 다시 가립니다(claire_check restore)." if pending else ""),
    }


def cmd_restore(args, cfg):
    """백업을 **새 빈 폴더**에 복원한다 (격리 사본). 운영 위치·위치 기록 대상에는 복원하지 않는다.
    가림 목록을 다시 적용하고(지운 개인정보 재도입 방지) 무결성·건수·파일 해시를 확인한다. 인증정보는 없다."""
    src = Path(args.from_path).expanduser()
    db_file = src / DB_NAME if src.is_dir() else src
    if not db_file.exists():
        raise ClaireError("backup_missing", f"백업 DB가 없습니다: {db_file}")
    dst = Path(args.to).expanduser()
    canon = claire_paths.resolve(use_env=False)
    if claire_paths.same_path(dst, canon.path) or claire_paths.same_path(dst, data_dir()):
        raise ClaireError("restore_target_live", f"운영 데이터 위치에는 바로 복원하지 않습니다: {dst}",
                          fix="빈 폴더에 복원해 확인한 뒤, 운영 전환은 references/recovery-policy.md 의 절차를 따르세요")
    if dst.exists() and any(p.name != ".DS_Store" for p in dst.iterdir()):
        raise ClaireError("restore_target_not_empty", f"복원 대상 폴더가 비어 있지 않습니다: {dst}")
    files_check = _verify_backup_files(src)
    if files_check["ok"] is False:
        raise ClaireError("backup_files_bad", "백업 파일 해시가 맞지 않습니다", files=files_check)
    dst.mkdir(parents=True, exist_ok=True, mode=0o700)
    claire_data.sqlite_snapshot(db_file, dst / DB_NAME)
    copied = 0
    if src.is_dir():
        for sub in ("attachments", "raw", "exports", "logs"):
            for p in sorted((src / sub).rglob("*")) if (src / sub).is_dir() else []:
                if p.is_file() and p.name != ".DS_Store":
                    claire_data.copy_hashed(p, dst / p.relative_to(src))
                    copied += 1
        if (src / "config.json").exists():
            claire_data.copy_hashed(src / "config.json", dst / "config.json")
    for sub in DATA_SUBDIRS:
        (dst / sub).mkdir(exist_ok=True)
    os.chmod(dst / "secrets", 0o700)
    conn = _open(dst / DB_NAME)
    entries = _redaction_sources(src, cfg)
    conn.execute("BEGIN IMMEDIATE")
    applied = claire_data.apply_redactions(conn, dst, entries)
    if applied:
        from claire_core import rebuild_fts
        rebuild_fts(conn)
    conn.execute("COMMIT")
    manifest = json.loads((src / "manifest.json").read_text(encoding="utf-8")) if src.is_dir() and (src / "manifest.json").exists() else None
    claire_paths.write_marker(dst, {"format": 1, "system": claire_paths.SYSTEM, "root_id": claire_paths.new_root_id(),
                                    "state": "active", "created_at": claire_paths.now_utc(),
                                    "restored_from": str(src), "isolated": True})
    integ = run_integrity(conn, cfg, root=dst)
    counts, chash = table_counts(conn), content_hash(conn)
    conn.close()
    match = None
    if manifest:
        match = manifest.get("counts") == counts and (manifest.get("content_hash") == chash or bool(applied))
    return {"restored_to": str(dst), "from": str(src), "files_copied": copied, "backup_files": files_check,
            "redactions_reapplied": applied, "counts": counts, "content_hash": chash,
            "manifest_match": match, "storage_ok": integ["storage_ok"], "problems": integ["problems"],
            "secrets_included": False, "secrets_policy": SECRETS_POLICY,
            "next": [f"CLAIRE_DATA_DIR={dst} {Path(__file__).resolve().parent}/claire_search find <검색어>   # 격리 사본 조회",
                     "운영 위치로 되돌리는 절차는 references/recovery-policy.md (claire_relocate)"]}


# --------------------------------------------------------------------------
# doctor (§4.3 확인 사항 실측, §11)
# --------------------------------------------------------------------------

class Doctor:
    def __init__(self, cfg, offline: bool):
        self.cfg = cfg
        self.offline = offline
        self.checks: list[dict] = []

    def add(self, area, name, status, detail="", fix=None, **extra):
        row = {"area": area, "name": name, "status": status, "detail": detail}
        if fix:
            row["fix"] = fix
        row.update(extra)
        self.checks.append(row)

    # -- 환경 ---------------------------------------------------------------
    def check_env(self):
        v = sys.version_info
        self.add("env", "python", "ok" if v >= (3, 11) else "fail",
                 f"{platform.python_version()} ({sys.executable})",
                 None if v >= (3, 11) else "Python 3.11 이상이 필요합니다")
        try:
            c = sqlite3.connect(":memory:")
            c.execute("CREATE VIRTUAL TABLE t USING fts5(a)")
            self.add("env", "sqlite_fts5", "ok", f"SQLite {sqlite3.sqlite_version}")
        except sqlite3.OperationalError as e:
            self.add("env", "sqlite_fts5", "fail", str(e))
        try:
            tz_of(self.cfg)
            self.add("env", "timezone", "ok", self.cfg["timezone"])
        except Exception as e:  # noqa: BLE001
            self.add("env", "timezone", "fail", str(e))
        gog = shutil.which("gog")
        self.add("env", "gog_cli", "ok" if gog else "warn",
                 f"{gog} (참고용. 증분 동기화 API가 없어 커넥터는 REST 직접 호출)" if gog
                 else "gog 미설치 (없어도 됨)")

    # -- 데이터 위치 (0.9.0) ----------------------------------------------------
    def check_location(self):
        loc = claire_paths.resolve()
        msgs = [b["message"] for b in loc.blockers] + [w["message"] for w in loc.warnings]
        fix = next((x.get("fix") for x in loc.blockers + loc.warnings if x.get("fix")), None)
        self.add("data", "data_location", "fail" if loc.blockers else "warn" if loc.warnings else "ok",
                 f"{loc.path} — {claire_paths.SOURCE_LABELS.get(loc.source)}" + (f" · {' / '.join(msgs)}" if msgs else ""),
                 fix, source=loc.source, pointer=loc.as_dict()["pointer"])
        if loc.source != "env":
            if not loc.pointer and not loc.blockers:
                self.add("data", "location_record", "warn", "위치 기록 없음 — 예약 실행은 자동 판단(기존 ~/ClaireData 우선)을 쓴다",
                         "claire_check init (위치 기록을 남긴다)")
            legacy = claire_paths.legacy_dir()
            if not claire_paths.same_path(legacy, loc.path) and claire_paths.has_db(legacy):
                m = claire_paths.read_marker(legacy) or {}
                self.add("data", "legacy_copy", "warn",
                         f"옛 위치 {legacy} 에 은퇴 표지 없는 장부가 남아 있음 (state={m.get('state')}). 이 장부는 쓰이지 않는다",
                         "claire_relocate status 로 확인")
        root = claire_paths.backup_root(self.cfg.get("backup_root"))
        anc = root
        while not anc.exists() and anc != anc.parent:
            anc = anc.parent
        synced = is_synced_location(root)
        ok = os.access(anc, os.W_OK) and not synced
        self.add("data", "backup_root", "ok" if ok else "fail",
                 f"{root} ({'있음' if root.exists() else '첫 백업 때 생성'})" + (f" — {synced} 동기화 폴더 안" if synced else "")
                 + ("" if os.access(anc, os.W_OK) else " — 쓰기 권한 없음"),
                 None if ok else "config backup_root 또는 CLAIRE_BACKUP_ROOT 를 확인하세요")
        lock = claire_paths.read_lock()
        if lock:
            live = claire_paths.lock_is_live()
            self.add("data", "relocation", "warn" if live else "fail",
                     f"데이터 이전 {'진행 중' if live else '중단됨'}: {lock.get('kind')} {lock.get('id')}",
                     "claire_relocate status")
        else:
            jd = claire_paths.journal_dir()
            journals = []
            for f in (sorted(jd.glob("*.json")) if jd.is_dir() else []):
                try:
                    j = json.loads(f.read_text(encoding="utf-8"))
                except (OSError, ValueError):
                    continue
                if isinstance(j, dict) and j.get("id") and j.get("kind"):
                    journals.append(j)
            if journals:
                j = max(journals, key=lambda x: x.get("started_at") or "")
                st = j.get("state")
                warns = j.get("warnings") or []
                fine = st in ("done", "aborted", "failed_clean", "not_started") and not warns
                cmds = [c for w in warns for c in (w.get("commands") or [])]
                self.add("data", "relocation", "ok" if fine else "warn",
                         f"마지막 이전 {j.get('id')} ({j.get('kind')}): {st} · {(j.get('source') or {}).get('root')} → "
                         f"{(j.get('target') or {}).get('root')}"
                         + (" · 경고: " + "; ".join(str(w.get("message")) for w in warns[:3]) if warns else ""),
                         None if fine else ("; ".join(cmds[:4]) if cmds else "claire_relocate status"))

    # -- 데이터 디렉터리 -----------------------------------------------------
    def check_data(self):
        self.check_location()
        d = data_dir()
        synced = is_synced_location(d)
        self.add("data", "data_dir", "fail" if synced else ("ok" if d.exists() else "warn"),
                 f"{d}" + (f" — {synced} 동기화 폴더 안" if synced else ""),
                 "claire_check init" if not d.exists() else
                 ("CLAIRE_DATA_DIR 을 동기화 폴더 밖으로 옮기세요 (§4.2)" if synced else None))
        if db_path().exists():
            try:
                conn = connect(create=False)
                ver = conn.execute("SELECT value FROM meta WHERE key='schema_version'").fetchone()["value"]
                integ = run_integrity(conn, self.cfg)
                self.add("data", "database", "ok" if integ["healthy"] else "warn",
                         f"schema v{ver}, 무결성 {'이상 없음' if integ['healthy'] else integ['problems'][:3]}",
                         counts=integ["counts"])
            except Exception as e:  # noqa: BLE001
                self.add("data", "database", "fail", str(e))
        else:
            self.add("data", "database", "fail", f"{db_path()} 없음", "claire_check init")
        for sub in DATA_SUBDIRS:
            p = d / sub
            if not p.is_dir():
                self.add("data", f"dir:{sub}", "fail", f"{p} 없음", "claire_check init")
                continue
            if sub == "secrets":
                mode = p.stat().st_mode & 0o777
                bad = [f.name for f in p.iterdir() if f.is_file() and (f.stat().st_mode & 0o077)]
                ok = mode == 0o700 and not bad
                self.add("data", "dir:secrets", "ok" if ok else "fail",
                         f"mode {oct(mode)}" + (f", 느슨한 파일 {bad}" if bad else ""),
                         None if ok else "chmod 700 secrets; chmod 600 secrets/*")
            else:
                self.add("data", f"dir:{sub}", "ok" if os.access(p, os.W_OK) else "fail", str(p))
        cfg_path = d / "config.json"
        self.add("data", "config", "ok" if cfg_path.exists() else "warn",
                 str(cfg_path) if cfg_path.exists() else "config.json 없음 (기본값 사용)",
                 None if cfg_path.exists() else "claire_check init")
        missing = []
        if not self.cfg["gmail"].get("accounts"):
            missing.append("gmail.accounts")
        if not self.cfg["gmail"].get("user_addresses"):
            missing.append("gmail.user_addresses")
        if not self.cfg.get("calendars"):
            missing.append("calendars")
        elif sum(1 for c in self.cfg["calendars"] if c.get("write")) != 1:
            missing.append("calendars[write=true] 정확히 1개")
        self.add("data", "config_values", "fail" if missing else "ok",
                 ("비어 있음: " + ", ".join(missing)) if missing else "계정·캘린더 설정 있음",
                 f"{cfg_path} 에 config.example.json 을 참고해 채우세요" if missing else None)
        mirror = Path(self.cfg["backup_mirror"]).expanduser()
        self.add("data", "backup_mirror", "ok" if (mirror.exists() or mirror.parent.exists()) else "warn",
                 f"{mirror} ({'있음' if mirror.exists() else '첫 백업 때 생성'})")

    # -- Google -------------------------------------------------------------
    def check_google(self):
        import google_api  # noqa: WPS433
        cs = google_api.client_summary(self.cfg)
        if not cs.get("present"):
            self.add("google", "oauth_client", "fail", f"{cs['path']} 없음",
                     "gog 를 설치·설정하거나 config.google.oauth_client_file 을 지정하세요")
        elif cs.get("error"):
            self.add("google", "oauth_client", "fail", cs["error"])
        else:
            self.add("google", "oauth_client", "ok", f"{cs['kind']} 클라이언트 …{cs['client_id_suffix'][-8:]}")

        write_cal = [c for c in self.cfg["calendars"] if c.get("write")]
        for email in self.cfg["gmail"]["accounts"]:
            ts = google_api.token_summary(self.cfg, email, "read")
            name = f"token:{email}:read"
            if not ts["present"]:
                self.add("google", name, "fail", "읽기 전용 토큰 없음",
                         f"python3 connectors/google_api.py authorize {email} --kind read")
                self.add("google", f"gmail:{email}", "skip", "토큰 없음")
                continue
            problems = []
            if not ts["mode_ok"]:
                problems.append(f"권한 {ts['mode']} (600 이어야 함)")
            if not ts["scopes_ok"]:
                problems.append(f"범위 부족 {ts['missing_scopes']}")
            if ts["has_write_scope"]:
                problems.append("쓰기 범위가 섞여 있음 (D1 위반)")
            if ts.get("email") and ts["email"].lower() != email.lower():
                problems.append(f"토큰 계정 {ts['email']} ≠ {email}")
            self.add("google", name, "fail" if problems else "ok",
                     "; ".join(problems) if problems else f"scopes {len(ts['scopes'])}개, 발급 {ts['obtained_at']}",
                     f"python3 connectors/google_api.py authorize {email} --kind read" if problems else None)
            if self.offline:
                self.add("google", f"gmail:{email}", "skip", "--offline")
                continue
            try:
                prof = google_api.ping_gmail(self.cfg, email)
                ok = (prof.get("emailAddress") or "").lower() == email.lower()
                self.add("google", f"gmail:{email}", "ok" if ok else "fail",
                         f"profile {prof.get('emailAddress')} historyId={prof.get('historyId')} "
                         f"messages={prof.get('messagesTotal')}",
                         None if ok else "토큰이 다른 계정으로 발급되었습니다. 다시 authorize 하세요")
            except ClaireError as e:
                self.add("google", f"gmail:{email}", "fail", e.message,
                         f"python3 connectors/google_api.py authorize {email} --kind read")

        for cal in self.cfg["calendars"]:
            name = f"calendar:{cal['name']}"
            email = cal["account"]
            if email not in self.cfg["gmail"]["accounts"]:
                self.add("google", name, "warn", f"계정 {email} 이 gmail.accounts 에 없음")
            tp = google_api.token_path(email, "read")
            if not tp.exists():
                self.add("google", name, "skip", f"{email} 토큰 없음")
                continue
            if self.offline:
                self.add("google", name, "skip", "--offline", id=cal["id"], mode=cal["mode"])
                continue
            try:
                info = google_api.ping_calendar(self.cfg, email, cal["id"])
                role = info.get("accessRole")
                need_write = bool(cal.get("write"))
                ok = role in ("owner", "writer") if need_write else role in ("owner", "writer", "reader")
                self.add("google", name, "ok" if ok else "fail",
                         f"{info.get('summary')} · {role} · mode={cal['mode']}"
                         + (" · write" if need_write else ""), None if ok else "캘린더 공유 권한을 확인하세요",
                         id=cal["id"])
            except ClaireError as e:
                self.add("google", name, "fail", e.message, id=cal["id"])
        for cal in write_cal:
            tp = google_api.token_path(cal["account"], "write")
            self.add("google", f"token:{cal['account']}:write", "ok" if tp.exists() else "warn",
                     "쓰기 토큰 있음" if tp.exists() else "쓰기 토큰 없음 — 4단계(외부 반영)에서 발급",
                     None if tp.exists() else
                     f"(4단계) python3 connectors/google_api.py authorize {cal['account']} --kind write")

    # -- Obsidian -----------------------------------------------------------
    def check_obsidian(self):
        import obsidian_tasks
        root = obsidian_tasks.vault_path(self.cfg)
        if not root.is_dir():
            self.add("obsidian", "vault", "fail", f"{root} 없음", "config.obsidian.vault 를 확인하세요")
            return
        self.add("obsidian", "vault", "ok", f"{root} ({'iCloud' if is_synced_location(root) else '로컬'})")
        daily = root / self.cfg["obsidian"]["daily_folder"]
        self.add("obsidian", "daily_folder", "ok" if daily.is_dir() else "warn", str(daily))
        guide = root / self.cfg["obsidian"].get("navigation_guide", "Vault_Navigation_Guide.md")
        self.add("obsidian", "navigation_guide", "ok" if guide.exists() else "warn", str(guide))
        for ex in self.cfg["obsidian"]["exclude_folders"]:
            p = root / ex
            if not ex.startswith("."):
                self.add("obsidian", f"exclude:{ex}", "ok" if p.is_dir() else "warn",
                         "제외 대상 존재" if p.is_dir() else "폴더 없음 (제외 규칙만 유지)")
        try:
            res = obsidian_tasks.scan_vault(self.cfg)
            self.add("obsidian", "tasks_scan", "ok" if res["tasks"] else "warn",
                     f"파일 {res['files_seen']}개, {self.cfg['obsidian']['tag']} 줄 {res['tasks']}건 "
                     f"{res['by_state']}, 🆔 있음 {res['with_id']}건",
                     None if res["tasks"] else "#tasks 줄이 하나도 없습니다. 태그·볼트 경로를 확인하세요")
            files_with_tasks = {t["file"] for t in res["items"]}
            self.add("obsidian", "write_access", "ok" if os.access(root, os.W_OK) else "fail",
                     f"쓰기 가능 여부 (4단계용). Tasks 있는 파일 {len(files_with_tasks)}개")
        except ClaireError as e:
            self.add("obsidian", "tasks_scan", "fail", e.message)

    # -- Discord ------------------------------------------------------------
    def check_discord(self):
        import discord_files
        s = discord_files.inbound_summary(self.cfg)
        if not s["present"]:
            self.add("discord", "inbound_media_dir", "fail", f"{s['path']} 없음",
                     "OpenClaw 첨부 저장 경로를 config.discord.inbound_media_dir 에 지정하세요")
        else:
            self.add("discord", "inbound_media_dir", "ok" if s["readable"] else "fail",
                     f"{s['path']} · 파일 {s['files']}개 (이미지 {s['images']}개)",
                     recent=s["recent"])
        tok = Path("~/.openclaw/claire-discord-token.txt").expanduser()
        self.add("discord", "claire_agent_token", "ok" if tok.exists() else "warn",
                 "OpenClaw Claire 에이전트 토큰 파일 있음 (내용은 읽지 않음)" if tok.exists()
                 else "OpenClaw 에 Claire 에이전트 토큰이 없음")
        to = (self.cfg.get("discord") or {}).get("send_to")
        self.add("discord", "send_to", "ok" if to else "warn",
                 f"보고·확인 메시지를 보낼 채널 {to}" if to else
                 "discord.send_to 없음 — cron 턴(06:00 보고·12/18시 확인)에서 보낼 채널을 모름 (전송 대상 미지정 실패)",
                 None if to else f"{Path(__file__).resolve().parent}/claire_check channel-target --write")
        self.add("discord", "message_id_passthrough", "warn",
                 "브리지가 message_id·첨부 경로·원 시각을 넘기는지는 실제 메시지로 확인해야 합니다. "
                 "없어도 sha256·fingerprint 2단 멱등성으로 동작합니다 (§6.4)",
                 "2단계 첫 이미지 입력 때 claire_sync ingest-discord 인자를 확인")

    # -- OpenClaw (2단계: 에이전트 연결·cron) -------------------------------
    def check_openclaw(self):
        ws = Path("~/.openclaw/workspace-claire").expanduser()
        if not ws.is_dir():
            self.add("openclaw", "workspace", "warn", f"{ws} 없음 (OpenClaw Claire 에이전트 미구성)")
            return
        sk = ws / "skills" / "claire-schedule-manager" / "SKILL.md"
        here = Path(__file__).resolve().parent.parent / "SKILL.md"
        same = sk.exists() and here.exists() and sk.read_bytes() == here.read_bytes()
        self.add("openclaw", "workspace_skill", "ok" if same else ("warn" if sk.exists() else "fail"),
                 f"{sk} ({'최신' if same else '설치본과 다름' if sk.exists() else '없음'})",
                 None if same else "install.sh 를 다시 실행하세요")
        oc = claire_paths.openclaw_bin()
        if self.offline or not oc:
            self.add("openclaw", "cron_daily", "skip", "--offline 또는 openclaw 미설치")
            return
        try:
            out = subprocess.run([oc, "cron", "list", "--json"], capture_output=True, text=True, timeout=30)
            data = json.loads(out.stdout)
            jobs = data if isinstance(data, list) else data.get("jobs") or data.get("automations") or []
            job = next((j for j in jobs if j.get("agentId") == "claire" and
                        (j.get("declarationKey") == "claire-daily-check" or "일일 점검" in (j.get("name") or ""))), None)
            if job is None:
                self.add("openclaw", "cron_daily", "fail", "Claire 06:00 cron 없음",
                         "references/doctor.md 의 cron 등록 명령을 실행하세요")
            else:
                sch = job.get("schedule") or {}
                ok = job.get("enabled", True) and sch.get("expr") == "0 6 * * *" and sch.get("tz") == "Asia/Seoul"
                self.add("openclaw", "cron_daily", "ok" if ok else "warn",
                         f"{job.get('name')} · {sch.get('expr')} @ {sch.get('tz')} · enabled={job.get('enabled')} · "
                         f"last={job.get('lastRunStatus') or job.get('state', {}).get('lastRunStatus')}")
            # 0.5.0: 12:00·18:00 미등록 일정 확인 (주말 포함)
            ck = [j for j in jobs if j.get("agentId") == "claire" and
                  (j.get("declarationKey") == "claire-checkin" or "미등록" in (j.get("name") or ""))]
            if not ck:
                self.add("openclaw", "cron_checkin", "warn", "12:00·18:00 미등록 일정 확인 cron 없음",
                         "references/doctor.md 의 '미등록 일정 확인 cron' 명령을 실행하세요")
            else:
                exprs = sorted({(j.get("schedule") or {}).get("expr") for j in ck})
                ok = (exprs == [CHECKIN_EXPR] and len(ck) == 1) and all(j.get("enabled", True) for j in ck) and \
                    all((j.get("schedule") or {}).get("tz") == "Asia/Seoul" for j in ck)
                self.add("openclaw", "cron_checkin", "ok" if ok else "warn",
                         f"{len(ck)}개 · {', '.join(str(e) for e in exprs)}" +
                         ("" if ok else f" (권장: 하나의 cron '{CHECKIN_EXPR}' @ Asia/Seoul, declaration key claire-checkin. "
                                        "Claire 가 임시로 만든 cron 이 있으면 지우고 다시 등록)"),
                         None if ok else "references/doctor.md 의 '미등록 일정 확인 cron' 명령")
        except (subprocess.TimeoutExpired, json.JSONDecodeError, OSError) as e:
            self.add("openclaw", "cron_daily", "warn", f"cron 목록을 읽지 못함: {e}")
        self.check_openclaw_buttons()

    def _openclaw_config_get(self, path: str):
        out = subprocess.run([claire_paths.openclaw_bin() or "openclaw", "config", "get", path],
                             capture_output=True, text=True, timeout=30)
        try:
            return json.loads(out.stdout)
        except json.JSONDecodeError:
            return None                              # 미설정이면 문장이 나온다

    def check_openclaw_buttons(self):
        """번호 버튼(v0.4.3): Claire 에이전트에 message 도구가 허용되고, 버튼 콜백 수명이 하루 브리핑을 덮는지."""
        try:
            tools = self._openclaw_config_get("agents.entries.claire.tools") or {}
            allow = set((tools.get("alsoAllow") or []) + (tools.get("allow") or []))
            profile = tools.get("profile") or (self._openclaw_config_get("tools") or {}).get("profile")
            has_msg = bool({"message", "group:messaging"} & allow) or profile in ("messaging", "full")
            self.add("openclaw", "message_tool", "ok" if has_msg else "warn",
                     "Claire 에이전트에 message 도구 허용됨 (Codex 하네스에서는 초기 목록에 없고 tool search로 로드 — SKILL §5)" if has_msg else
                     "Claire 에이전트에 message 도구가 없음 → 번호 버튼 없이 코드 블록으로만 답한다",
                     None if has_msg else "echo '{agents:{entries:{claire:{tools:{alsoAllow:[\"message\"]}}}}}' | openclaw config patch --stdin")
            comp = self._openclaw_config_get("channels.discord.accounts.claire.agentComponents") or \
                self._openclaw_config_get("channels.discord.agentComponents") or {}
            ttl = int(comp.get("ttlMs") or 1800000)
            ok = ttl >= 12 * 3600 * 1000
            self.add("openclaw", "button_ttl", "ok" if ok else "warn",
                     f"버튼 콜백 수명 {ttl // 60000}분" + ("" if ok else " (06:00 브리핑 버튼이 오전에 만료됨)"),
                     None if ok else "echo '{channels:{discord:{accounts:{claire:{agentComponents:{ttlMs:86400000}}}}}}' | openclaw config patch --stdin")
            guilds = self._openclaw_config_get("channels.discord.accounts.claire.guilds") or \
                self._openclaw_config_get("channels.discord.guilds") or {}
            status, detail = channel_prompt_status(find_claire_channels(guilds), channel_prompt_text())
            self.add("openclaw", "channel_prompt", status, detail,
                     None if status == "ok" else
                     f"{Path(__file__).resolve().parent}/claire_check channel-prompt | openclaw config patch --stdin && openclaw gateway restart")
        except (subprocess.TimeoutExpired, OSError, ValueError, TypeError) as e:
            self.add("openclaw", "message_tool", "warn", f"OpenClaw 설정을 읽지 못함: {e}")

    def run(self) -> dict:
        self.check_env()
        self.check_data()
        self.check_google()
        self.check_obsidian()
        self.check_discord()
        self.check_openclaw()
        tally = {s: sum(1 for c in self.checks if c["status"] == s) for s in ("ok", "warn", "fail", "skip")}
        blocking = [c for c in self.checks if c["status"] == "fail"]
        return {"claire_version": CLAIRE_VERSION, "offline": self.offline, "checked_at": now_iso(self.cfg),
                "all_green": not blocking and tally["skip"] == 0 and not self.offline,
                "tally": tally, "checks": self.checks,
                "next_steps": [c["fix"] for c in self.checks if c.get("fix")],
                "text": self.render()}

    def render(self) -> str:
        icon = {"ok": "✅", "warn": "⚠️ ", "fail": "❌", "skip": "⏭️ "}
        w = max(len(c["name"]) for c in self.checks) + 2
        lines = [f"Claire doctor — {CLAIRE_VERSION} · {'offline' if self.offline else 'live'}"]
        area = None
        for c in self.checks:
            if c["area"] != area:
                area = c["area"]
                lines.append(f"\n[{area}]")
            lines.append(f"  {icon[c['status']]} {c['name']:<{w}} {c['detail']}")
            if c.get("fix"):
                lines.append(f"     ↳ {c['fix']}")
        return "\n".join(lines)


def cmd_doctor(args, cfg):
    return Doctor(cfg, offline=args.offline).run()


def cmd_channel_prompt(args, cfg):
    """OpenClaw 채널별 systemPrompt 패치 JSON 을 stdout 에 낸다 (`| openclaw config patch --stdin`).
    --guild/--channel 을 안 주면 OpenClaw 설정에서 Claire 계정의 첫 enabled 채널을 쓴다. 설정을 직접 바꾸지는 않는다."""
    guild, channel = args.guild, args.channel
    if not (guild and channel):
        if not shutil.which("openclaw"):
            raise ClaireError("openclaw_missing", "openclaw 가 없으면 --guild 와 --channel 을 직접 주세요")
        out = subprocess.run(["openclaw", "config", "get", "channels.discord.accounts.claire.guilds"],
                             capture_output=True, text=True, timeout=30)
        try:
            found = find_claire_channels(json.loads(out.stdout))
        except json.JSONDecodeError:
            found = []
        if not found:
            raise ClaireError("channel_not_found", "OpenClaw Claire 계정에 enabled 된 Discord 채널이 없음. --guild/--channel 을 주세요")
        guild, channel = found[0]["guild"], found[0]["channel"]
    patch = {"channels": {"discord": {"accounts": {"claire": {"guilds": {guild: {"channels": {channel: {
        "systemPrompt": channel_prompt_text()}}}}}}}}}
    print(json.dumps(patch, ensure_ascii=False))
    sys.exit(0)


def cmd_channel_target(args, cfg):
    """보고를 보낼 Discord 채널(`channel:<id>`)을 config.json discord.send_to 에 둔다 (0.6.0).
    cron 턴에는 '지금 대화 중인 채널'이 없어 버튼 전송이 '전송 대상 미지정'으로 실패했다(ISSUE 2026-09-27 §2.4).
    --channel 을 안 주면 OpenClaw Claire 계정의 enabled 채널에서 찾는다. --write 가 없으면 보여 주기만 한다."""
    current = (cfg.get("discord") or {}).get("send_to")
    channel = args.channel
    found = []
    if not channel:
        if not shutil.which("openclaw"):
            return {"current": current, "found": [], "written": False,
                    "message": "openclaw 가 없어 채널을 찾지 못했습니다. --channel <id> 로 직접 주세요."}
        out = subprocess.run(["openclaw", "config", "get", "channels.discord.accounts.claire.guilds"],
                             capture_output=True, text=True, timeout=30)
        try:
            found = find_claire_channels(json.loads(out.stdout))
        except json.JSONDecodeError:
            found = []
        if len(found) != 1:
            return {"current": current, "found": found, "written": False,
                    "message": ("enabled 채널이 없습니다." if not found else
                                f"enabled 채널이 {len(found)}개입니다. --channel <id> 로 고르세요.")}
        channel = found[0]["channel"]
    target = channel if str(channel).startswith("channel:") else f"channel:{channel}"
    written = False
    if args.write and target != current:
        path = data_dir() / "config.json"
        user = json.loads(path.read_text(encoding="utf-8")) if path.exists() else {}
        user.setdefault("discord", {})["send_to"] = target
        atomic_write_text(path, json.dumps(user, ensure_ascii=False, indent=2) + "\n")
        written = True
    return {"current": current, "send_to": target, "found": found, "written": written,
            "message": (f"discord.send_to = {target} 로 저장했습니다." if written else
                        f"보낼 채널: {target}" + ("" if target == current else " (저장하려면 --write)"))}


def _semver(tag: str) -> tuple | None:
    import re
    m = re.fullmatch(r"v?(\d+)\.(\d+)\.(\d+)", tag.strip())
    return tuple(int(x) for x in m.groups()) if m else None


def latest_remote_tag(url: str = REPO_URL, timeout: int = 20) -> str | None:
    out = subprocess.run(["git", "ls-remote", "--tags", "--refs", url], capture_output=True, text=True, timeout=timeout)
    if out.returncode != 0:
        raise ClaireError("remote_unavailable", f"GitHub 태그를 읽지 못했습니다: {out.stderr.strip()[:200]}")
    tags = [line.rsplit("/", 1)[-1] for line in out.stdout.splitlines() if "refs/tags/" in line]
    tags = [t for t in tags if _semver(t)]
    return max(tags, key=_semver) if tags else None


def cmd_version(args, cfg):
    """설치된 스킬 버전·출처. --remote 면 GitHub 최신 릴리스 태그와 비교해 업데이트 명령을 알려 준다."""
    info = json.loads(INSTALL_INFO.read_text(encoding="utf-8")) if INSTALL_INFO.exists() else None
    db_ver = None
    if db_path().exists() and not claire_paths.resolve().blockers:
        try:
            db_ver = int(connect(create=False).execute("SELECT value FROM meta WHERE key='schema_version'").fetchone()[0])
        except Exception:  # noqa: BLE001
            db_ver = None
    loc = claire_paths.resolve()
    out = {"version": CLAIRE_VERSION, "schema_version": SCHEMA_VERSION, "db_schema_version": db_ver,
           "installed": info, "skill_dir": str(Path(__file__).resolve().parent.parent),
           "data_dir": str(loc.path), "data_source": loc.source, "data_usable": not loc.blockers}
    if args.remote:
        latest = latest_remote_tag()
        out["latest"] = latest
        cur, new = _semver(CLAIRE_VERSION), _semver(latest or "")
        out["update_available"] = bool(cur and new and new > cur)
        out["message"] = (f"새 버전 {latest} 이 있습니다 (설치 {CLAIRE_VERSION}). 업데이트: claire-update"
                          if out["update_available"] else f"최신입니다 ({CLAIRE_VERSION}).")
    return out


def cmd_calibrate(args, cfg):
    conn = connect(create=False)
    n = conn.execute("SELECT COUNT(*) c FROM outbox WHERE op LIKE 'calendar.%' AND requires_confirm=1").fetchone()["c"]
    return {"samples": n, "current_auto_merge_threshold": cfg["auto_merge_threshold"],
            "verdict": "근거 부족. 5단계 재검토 조건(§15.1)을 채우기 전에는 임계값을 낮추지 않습니다."}


def build_parser():
    p = argparse.ArgumentParser(prog="claire_check", description="Claire 초기화·무결성·백업·진단")
    sub = p.add_subparsers(dest="cmd")
    n = sub.add_parser("init", help="데이터 디렉터리와 스키마 생성 (멱등)")
    n.set_defaults(fn=cmd_init)
    i = sub.add_parser("integrity", help="무결성 검사 (§10)")
    i.add_argument("--strict", action="store_true")
    i.set_defaults(fn=cmd_integrity)
    b = sub.add_parser("backup", help="백업 생성 (§10) — 기본 백업 루트 ~/SecretaryBackups/schedule (0.9.0)")
    b.add_argument("--out", help="백업 루트 (이 아래 <시각>/ 을 만든다). 기본: CLAIRE_BACKUP_ROOT > config backup_root")
    b.add_argument("--no-mirror", action="store_true")
    b.set_defaults(fn=cmd_backup)
    r = sub.add_parser("restore-test", help="백업 복구 시험 (TC20)")
    r.add_argument("--from", dest="from_path", required=True)
    r.set_defaults(fn=cmd_restore_test)
    rr = sub.add_parser("restore", help="백업을 새 빈 폴더에 격리 복원 (가림 재적용·검증, 0.9.0)")
    rr.add_argument("--from", dest="from_path", required=True)
    rr.add_argument("--to", required=True)
    rr.set_defaults(fn=cmd_restore)
    d = sub.add_parser("doctor", help="연결 진단 (§4.3 확인 사항 실측)")
    d.add_argument("--offline", action="store_true", help="네트워크 호출 없이 파일·설정만 검사")
    d.add_argument("--format", choices=["json", "text"], default="json")
    d.set_defaults(fn=cmd_doctor)
    cp = sub.add_parser("channel-prompt", help="Claire 채널 systemPrompt 패치 JSON 출력 (| openclaw config patch --stdin)")
    cp.add_argument("--guild")
    cp.add_argument("--channel")
    cp.set_defaults(fn=cmd_channel_prompt)
    ct = sub.add_parser("channel-target", help="cron 턴 전송 채널 discord.send_to 확인·설정 (0.6.0)")
    ct.add_argument("--channel")
    ct.add_argument("--write", action="store_true")
    ct.set_defaults(fn=cmd_channel_target)
    v = sub.add_parser("version", help="설치 버전·출처 (--remote: GitHub 최신 릴리스와 비교)")
    v.add_argument("--remote", action="store_true")
    v.set_defaults(fn=cmd_version)
    c = sub.add_parser("calibrate", help="임계값 조정 근거 (5단계)")
    c.set_defaults(fn=cmd_calibrate)
    return p


if __name__ == "__main__":
    run_cli(build_parser, lambda args, cfg: args.fn(args, cfg))
