#!/usr/bin/env python3
"""claire_relocate — Claire 데이터 위치 확인·이전·되돌리기 (0.9.0).

  where                         지금 데이터 위치·백업 루트·막힌 이유 (install.sh·예약 실행과 같은 판단)
  plan [--to] [...]             이전 계획 (dry-run — 장부·설정·예약을 바꾸지 않는다)
  migrate --confirm [--to] [--pause-schedules] [--backup-root] [--registry | --no-registry]
          [--accept-source-problems] [--replace-retired] [--quiet-minutes N]
                                기존 정본 → 새 위치(기본 ~/SecretaryData/services/schedule) 이전
  status [--id]                 위치·잠금·이전 기록
  resume [--id]                 중단된 이전·되돌리기를 이어서
  abort [--id] [--keep-changed-target]
                                중단된 이전·되돌리기를 원래대로 (옛 원본으로 계속 운영).
                                전환 뒤 새 위치에 기록이 생겼으면 멈춘다 — resume 으로 마치거나,
                                --keep-changed-target 으로 그 폴더를 지우지 않고 비켜 둔 뒤 되돌린다
  rollback [--id] [--confirm]   끝난 이전을 되돌린다 (먼저 --confirm 없이 계획을 본다)

모든 하위 명령은 JSON 을 낸다. plan·status 는 --format text 로 사람이 읽는 요약.
인증정보 값·파일 이름은 출력하지 않는다. 실제 이전은 교수님 확인 뒤 사람이 직접 실행한다(에이전트가 실행하지 않는다).
"""

from __future__ import annotations

import argparse
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from claire_core import ClaireError, run_cli  # noqa: E402
import claire_paths  # noqa: E402
import claire_relocation as R  # noqa: E402


def cmd_where(args, cfg):
    loc = claire_paths.resolve()
    out = loc.as_dict()
    out["backup_root"] = str(claire_paths.backup_root(cfg.get("backup_root")))
    out["app_home"] = str(claire_paths.app_home())
    out["legacy_dir"] = str(claire_paths.legacy_dir())
    out["default_dir"] = str(claire_paths.default_dir())
    if loc.source == "env":
        canon = claire_paths.resolve(use_env=False)
        out["canonical"] = {"data_dir": str(canon.path), "source": canon.source, "blockers": canon.blockers}
    if args.shell:
        q = lambda s: "'" + str(s).replace("'", "'\\''") + "'"  # noqa: E731
        print(f"DATA_DIR={q(out['data_dir'])}\nDATA_SOURCE={q(out['source'])}\nBACKUP_ROOT={q(out['backup_root'])}\n"
              f"APP_HOME={q(out['app_home'])}\nBLOCKED={q(' / '.join(b['message'] for b in loc.blockers))}\n"
              f"BLOCK_CODE={q(loc.blockers[0]['code'] if loc.blockers else '')}\n"
              f"BLOCK_CODES={q(' '.join(b['code'] for b in loc.blockers))}\n"
              f"BLOCK_LIVE={q('1' if any(b.get('live') for b in loc.blockers) else '')}")
        sys.exit(0)
    return out


def _opts(args, cfg, **kw):
    return R.default_options(cfg, to=args.to, backup_root=args.backup_root, registry=args.registry,
                             no_registry=args.no_registry, quiet_minutes=args.quiet_minutes,
                             pause_schedules=args.pause_schedules,
                             accept_source_problems=args.accept_source_problems,
                             replace_retired=args.replace_retired, **kw)


def cmd_plan(args, cfg):
    p = R.build_plan(cfg, _opts(args, cfg))
    if args.format == "text":
        p["text"] = R.render_plan(p)
    return p


def cmd_migrate(args, cfg):
    if not args.confirm:
        raise ClaireError("confirm_required", "실제 이전은 --confirm 이 있어야 합니다. 먼저 claire_relocate plan 으로 계획을 보세요")
    return R.migrate(cfg, _opts(args, cfg))


def cmd_status(args, cfg):
    s = R.status(args.id)
    if args.format == "text":
        s["text"] = R.render_status(s)
    return s


def cmd_resume(args, cfg):
    return R.resume(cfg, args.id)


def cmd_abort(args, cfg):
    return R.abort(cfg, args.id, keep_changed_target=args.keep_changed_target)


def cmd_rollback(args, cfg):
    kw = {"backup_root": args.backup_root, "registry": args.registry, "no_registry": args.no_registry,
          "quiet_minutes": args.quiet_minutes, "pause_schedules": args.pause_schedules}
    return R.rollback(cfg, args.id, args.confirm, kw)


def _common(sp, to=True):
    if to:
        sp.add_argument("--to", help="새 데이터 위치 (기본 ~/SecretaryData/services/schedule)")
    sp.add_argument("--backup-root", help="이전 전 백업을 둘 루트 (기본: config backup_root > ~/SecretaryBackups/schedule)")
    sp.add_argument("--registry", help="공용 registry.json (기본 ~/SecretaryData/registry.json, 없으면 handoff 파일만)")
    sp.add_argument("--no-registry", action="store_true", help="registry.json 을 고치지 않고 handoff 파일만 남김")
    sp.add_argument("--pause-schedules", action="store_true", help="이전 동안 OpenClaw claire-* 예약을 멈췄다가 다시 켠다")
    sp.add_argument("--quiet-minutes", type=int, default=20, help="예약을 멈추지 않을 때, 이 시간 안 실행 예정이 없어야 한다")
    if to:
        sp.add_argument("--accept-source-problems", action="store_true", help="원본의 장부·첨부 문제를 알고 그대로 옮김")
        sp.add_argument("--replace-retired", action="store_true", help="대상이 은퇴한 Claire 위치면 비켜 두고(<대상>.retired-<id>) 쓴다")


def build_parser():
    p = argparse.ArgumentParser(prog="claire_relocate", description="Claire 데이터 위치 확인·이전·되돌리기")
    sub = p.add_subparsers(dest="cmd")
    w = sub.add_parser("where", help="지금 데이터 위치와 막힌 이유")
    w.add_argument("--shell", action="store_true", help="install.sh 용 셸 변수 출력")
    w.set_defaults(fn=cmd_where)
    pl = sub.add_parser("plan", help="이전 계획 (dry-run)")
    _common(pl)
    pl.add_argument("--format", choices=["json", "text"], default="json")
    pl.set_defaults(fn=cmd_plan)
    m = sub.add_parser("migrate", help="이전 실행 (--confirm 필요)")
    _common(m)
    m.add_argument("--confirm", action="store_true")
    m.set_defaults(fn=cmd_migrate)
    s = sub.add_parser("status", help="위치·잠금·이전 기록")
    s.add_argument("--id")
    s.add_argument("--format", choices=["json", "text"], default="json")
    s.set_defaults(fn=cmd_status)
    r = sub.add_parser("resume", help="중단된 작업 이어서")
    r.add_argument("--id")
    r.set_defaults(fn=cmd_resume)
    a = sub.add_parser("abort", help="중단된 작업을 원래대로")
    a.add_argument("--id")
    a.add_argument("--keep-changed-target", action="store_true",
                   help="전환 뒤 기록이 있는 새 위치를 지우지 않고 .<이름>.undone-<id> 로 비켜 둔 채 되돌림")
    a.set_defaults(fn=cmd_abort)
    rb = sub.add_parser("rollback", help="끝난 이전 되돌리기 (--confirm 없으면 계획만)")
    rb.add_argument("--id")
    rb.add_argument("--confirm", action="store_true")
    _common(rb, to=False)
    rb.set_defaults(fn=cmd_rollback)
    return p


if __name__ == "__main__":
    run_cli(build_parser, lambda args, cfg: args.fn(args, cfg))
