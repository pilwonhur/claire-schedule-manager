#!/usr/bin/env python3
"""claire_export — JSON / Markdown 내보내기 (PRD §10, §11).

  json --out <file> [--since YYYY-MM-DD]     모든 표를 그대로 덤프 (백업 산출물)
  md   --out <dir>  [--since YYYY-MM-DD]     Obsidian 열람용 목록 (1단계: 항목 목록 1파일)

secrets/ 는 어떤 경우에도 포함하지 않는다.
"""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from claire_core import (  # noqa: E402
    CLAIRE_VERSION, COUNT_TABLES, SCHEMA_VERSION, atomic_write_text, connect, content_hash,
    now_iso, ref_sort_key, run_cli, table_counts,
)


def dump_tables(conn, since: str | None = None) -> dict:
    out = {}
    for t in COUNT_TABLES + ["meta"]:
        rows = [dict(r) for r in conn.execute(f"SELECT * FROM {t}")]
        if since and t in ("item", "source_event", "question", "activity_log", "run"):
            col = {"item": "updated_at", "source_event": "ingested_at", "question": "created_at",
                   "activity_log": "created_at", "run": "started_at"}[t]
            rows = [r for r in rows if (r.get(col) or "") >= since]
        out[t] = rows
    return out


def cmd_json(args, cfg):
    conn = connect(create=False)
    ts = now_iso(cfg)
    payload = {
        "exported_at": ts, "claire_version": CLAIRE_VERSION, "schema_version": SCHEMA_VERSION,
        "since": args.since, "counts": table_counts(conn), "content_hash": content_hash(conn),
        "tables": dump_tables(conn, args.since),
    }
    out = Path(args.out).expanduser()
    atomic_write_text(out, json.dumps(payload, ensure_ascii=False, indent=1, default=str) + "\n")
    return {"out": str(out), "counts": payload["counts"], "content_hash": payload["content_hash"]}


def cmd_md(args, cfg):
    conn = connect(create=False)
    ts = now_iso(cfg)
    out_dir = Path(args.out).expanduser()
    out_dir.mkdir(parents=True, exist_ok=True)
    rows = [dict(r) for r in conn.execute("SELECT * FROM item WHERE deleted_at IS NULL")]
    rows.sort(key=lambda r: ref_sort_key(r["ref"]))
    lines = [f"# Claire 항목 목록", "", f"내보낸 시각: {ts} · 항목 {len(rows)}건", "",
             "| 번호 | 종류 | 상태 | 제목 | 마감/시작 | 프로젝트 |", "|---|---|---|---|---|---|"]
    for r in rows:
        when = r.get("due_at") or r.get("start_at") or ""
        title = (r["title"] or "").replace("|", "\\|")
        project = (r.get("project") or "").replace("|", "\\|")    # f-string 안 역슬래시는 3.12 부터만 허용
        lines.append(f"| {r['ref']} | {r['kind']} | {r['status']} | {title} | {when[:16]} | {project} |")
    atomic_write_text(out_dir / "claire-items.md", "\n".join(lines) + "\n")
    files = ["claire-items.md"]
    # 0.8.0: 메모함 (업무와 따로). 되돌리기(이전 버전 설치) 뒤에도 메모를 읽을 수 있게 백업마다 남긴다.
    memos = [dict(r) for r in conn.execute("SELECT * FROM memo ORDER BY id")] if conn.execute(
        "SELECT 1 FROM sqlite_master WHERE type='table' AND name='memo'").fetchone() else []
    if memos:
        ko = {"open": "열림", "reference": "참고 보관", "resolved": "해결됨", "not_needed": "불필요"}
        ml = ["# Claire 메모함", "", f"내보낸 시각: {ts} · 메모 {len(memos)}건", ""]
        for m in memos:
            ml += [f"## {m['ref']} · {m['title']}", f"- 상태: {ko.get(m['status'], m['status'])} · 기록 {m['recorded_at'][:16]}"
                   + (f" · 주제 {m['topic']}" if m["topic"] else "")
                   + (f" · 정리 사유: {m['status_reason']}" if m["status_reason"] else ""),
                   f"- 출처: {m['source_platform']} {m['source_message_id'] or ''}".rstrip(), ""]
            ml += [f"> {l}" if l.strip() else ">" for l in m["body"].split("\n")]
            if m["body"] != m["original_text"]:
                ml += ["", "처음 기록:"] + [f"> {l}" if l.strip() else ">" for l in m["original_text"].split("\n")]
            ml.append("")
        atomic_write_text(out_dir / "claire-memos.md", "\n".join(ml) + "\n")
        files.append("claire-memos.md")
    return {"out": str(out_dir), "files": files, "items": len(rows), "memos": len(memos)}


def build_parser():
    p = argparse.ArgumentParser(prog="claire_export", description="Claire 내보내기")
    sub = p.add_subparsers(dest="cmd")
    j = sub.add_parser("json")
    j.add_argument("--out", required=True)
    j.add_argument("--since")
    j.set_defaults(fn=cmd_json)
    m = sub.add_parser("md")
    m.add_argument("--out", required=True)
    m.add_argument("--since")
    m.set_defaults(fn=cmd_md)
    return p


if __name__ == "__main__":
    run_cli(build_parser, lambda args, cfg: args.fn(args, cfg))
