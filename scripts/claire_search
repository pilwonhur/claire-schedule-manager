#!/usr/bin/env python3
"""claire_search — 조회 (PRD §8.1 6단계, §11). DB만 읽는다.

2단계 범위:
  review   [--run ID]                    브리핑 재료 일괄 조회
  today    [--date YYYY-MM-DD]           오늘 일정·마감·예정
  week     [--date YYYY-MM-DD]           이번 주(7일) 마감·일정
  overdue                                기한 지난 미완료
  questions [--due-now]                  열린 질문
  show --item CLR-0001                   항목 상세 (출처·질문·이력·연결)
  find --q "심사 의견" [--status open|all|done] [--project] [--since] [--until]   한국어 검색 (근거 포함)
  history --item CLR-0001                변경 이력
  trace --source-event 981 | --item CLR  원문 역추적 (원문 → 항목 → 이력)
  waiting [--who "김 교수"]               답변 대기 항목
  dupcheck --title "김 교수 면담" [--date YYYY-MM-DD]   등록 전 중복 후보 (미등록 일정 확인 답변용, 0.5.0)
  agenda                                 업무 현황 재료 (활성 미완료 전체·구역·진행 확인 대상, 0.6.0). 보낼 때는 claire_buttons agenda
  importance-review                      중요도 검토 필요(소급 분류·요청 범위 미분류) 업무와 판단 근거 (0.6.0)
  report                                 아침 보고 재료 (0.7.0: 구역별 상세·키워드·숨김 건수·accounting). 보낼 때는 claire_buttons report
  labels-missing [--limit 40]            키워드 이름(short_label)이 없는 활성 업무 — 보고의 키워드 요약용 (0.7.0)

0.5.0: 항목마다 업무 상태(status)와 별개로 외부 반영 상태(sync: calendar·tasks·daily)와 한 줄 요약(state_line)을 낸다.
0.6.0: 항목마다 중요도·근거·진행 확인 계획(tracking)과 시간 종류(time_kind: appointment|work|deadline_marker).
       겹침(overlaps)은 실제 약속·작업 예약·overlay 끼리만. 자동 마감 표시끼리 겹친 것은 deadline_clusters(작업량 안내).
"""

from __future__ import annotations

import argparse
import json
import sys
from datetime import datetime, timedelta
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import sqlite3  # noqa: E402
import unicodedata  # noqa: E402
from claire_core import (  # noqa: E402
    ClaireError, OPEN_STATUSES, connect, fts_query, get_item, hits, now_dt, now_iso, parse_iso, ref_order_sql,
    run_cli, tokenize, tz_of,
)
import claire_ops as ops  # noqa: E402
import claire_track as track  # noqa: E402

_CTX: dict = {}          # 명령 하나 동안의 conn·cfg (항목마다 반영 상태를 붙이기 위해)

OPEN_SQL = "status IN (" + ",".join(f"'{s}'" for s in OPEN_STATUSES) + ")"


def _item(r) -> dict:
    d = dict(r)
    out = {k: d.get(k) for k in ("ref", "title", "kind", "status", "priority", "project", "start_at", "end_at",
                                 "all_day", "due_at", "due_precision", "scheduled_on", "tentative", "attendance",
                                 "confidence", "waiting_on", "next_check_at", "next_action", "done_criteria",
                                 "completed_at", "updated_at", "request_scope", "priority_source", "priority_reason",
                                 "close_reason", "review_after", "check_every_days")}
    if d.get("window_auto"):
        out["calendar_window"] = "auto"      # start_at·end_at 은 마감에서 만든 달력 표시 구간
    conn, cfg = _CTX.get("conn"), _CTX.get("cfg")
    if conn is not None and "id" in d and "daily_logged_on" in d:
        out["sync"] = ops.sync_state_of(conn, r)
        out["state_line"] = ops.describe_state(conn, cfg, r)
        out["status_label"] = ops.status_label(r)
        out["time_kind"] = track.time_kind(r, cfg)
        if "close_reason" in d:
            plan = track.check_plan(cfg, r, now_dt(cfg), track.tracking_since(conn, cfg))
            out["tracking"] = {"priority": track.PRIORITY_KO.get(d["priority"]), "reason": d.get("priority_reason"),
                               "source": d.get("priority_source"), "check_due": plan["due"], "check_reason": plan["reason"],
                               "check_label": plan["label"],
                               "next_check_on": plan["next_on"].isoformat() if plan.get("next_on") else None}
    return out


def _ctx(conn, cfg):
    _CTX.update(conn=conn, cfg=cfg)
    return conn


def _day_bounds(cfg, day: str) -> tuple[str, str]:
    off = now_dt(cfg).strftime("%z"); off = off[:3] + ":" + off[3:]
    return f"{day}T00:00:00{off}", f"{day}T23:59:59{off}"


def _local_day(ts: str | None, cfg) -> str | None:
    if not ts:
        return None
    if len(ts) == 10:
        return ts
    try:
        return parse_iso(ts).astimezone(tz_of(cfg)).strftime("%Y-%m-%d")
    except ValueError:
        return ts[:10]


def _meetings_on(conn, cfg, day: str) -> list[dict]:
    out = []
    for r in conn.execute(f"SELECT * FROM item WHERE deleted_at IS NULL AND kind='meeting' AND {OPEN_SQL} "
                          "AND start_at IS NOT NULL"):
        if _local_day(r["start_at"], cfg) == day:
            d = _item(r)
            d["preps"] = [dict(p) for p in conn.execute(
                "SELECT i.ref, i.title, i.status FROM relation rl JOIN item i ON i.id=rl.from_item_id "
                "WHERE rl.rel_type='prep_for' AND rl.to_item_id=?", (r["id"],))]
            d["link_status"] = [l["sync_status"] for l in conn.execute(
                "SELECT sync_status FROM link WHERE item_id=? AND system='calendar'", (r["id"],))]
            d["questions"] = [q["ref"] for q in conn.execute(
                "SELECT ref FROM question WHERE item_id=? AND status='open'", (r["id"],))]
            out.append(d)
    out.sort(key=lambda x: x["start_at"] or "")
    return out


def _overlay_on(conn, cfg, day: str) -> list[dict]:
    return track.overlay_on(conn, cfg, day)


def _due_between(conn, cfg, start: str, end: str) -> list[dict]:
    rows = [_item(r) for r in conn.execute(
        f"SELECT * FROM item WHERE deleted_at IS NULL AND {OPEN_SQL} AND due_at IS NOT NULL "
        "AND due_at >= ? AND due_at <= ? ORDER BY due_at", (start, end))]
    return rows


def _overdue(conn, cfg, now_s: str) -> list[dict]:
    return [_item(r) for r in conn.execute(
        f"SELECT * FROM item WHERE deleted_at IS NULL AND {OPEN_SQL} AND due_at IS NOT NULL AND due_at < ? "
        "ORDER BY due_at", (now_s,))]


def _open_questions(conn, now_s: str, due_now: bool) -> list[dict]:
    out = []
    for q in conn.execute("SELECT q.*, i.ref AS item_ref, i.title AS item_title FROM question q "
                          "LEFT JOIN item i ON i.id=q.item_id WHERE q.status='open' ORDER BY q.id"):
        if due_now and q["next_ask_at"] and q["next_ask_at"] > now_s:
            continue
        out.append({"ref": q["ref"], "item_ref": q["item_ref"], "item_title": q["item_title"], "field": q["field"],
                    "question": q["question"], "options": json.loads(q["options"]) if q["options"] else None,
                    "reason": q["reason"], "asked_count": q["asked_count"], "last_asked_at": q["last_asked_at"],
                    "next_ask_at": q["next_ask_at"]})
    return out


def cmd_review(args, cfg):
    conn = _ctx(connect(create=False), cfg)
    now = now_dt(cfg); now_s = now.isoformat(); today = now.strftime("%Y-%m-%d")
    d0, d1 = _day_bounds(cfg, today)
    imminent_end = _day_bounds(cfg, (now + timedelta(days=int(cfg["briefing"]["imminent_days"]))).strftime("%Y-%m-%d"))[1]

    last_brief = conn.execute("SELECT sent_at FROM briefing WHERE kind='morning' ORDER BY id DESC LIMIT 1").fetchone()
    since = last_brief["sent_at"] if last_brief else "0000"

    meetings = _meetings_on(conn, cfg, today)
    overlays = _overlay_on(conn, cfg, today)
    day = track.day_conflicts(conn, cfg, now.date(), overlays)
    new_items, changed = [], []
    for r in conn.execute(
        "SELECT a.action, a.field, a.old_value, a.new_value, a.reason, a.created_at, i.* FROM activity_log a "
        "JOIN item i ON i.id=a.item_id WHERE a.created_at > ? AND a.undone_at IS NULL "
        "AND a.action IN ('create','update','complete','link') ORDER BY a.id", (since,)):
        d = _item(r)
        if r["action"] == "create":
            if r["status"] != "captured":
                new_items.append(d)
        else:
            changed.append({**d, "change": {"action": r["action"], "field": r["field"], "old": r["old_value"],
                                            "new": r["new_value"], "reason": r["reason"]}})
    captured = [_item(r) for r in conn.execute(
        "SELECT * FROM item WHERE deleted_at IS NULL AND status='captured' AND created_at > ? ORDER BY id", (since,))]
    ignored = {r["ignore_reason"]: r["c"] for r in conn.execute(
        "SELECT ignore_reason, COUNT(*) c FROM source_event WHERE triage='ignored' AND ingested_at > ? "
        "GROUP BY ignore_reason", (since,))}
    suspicious = [{"source_event_id": r["id"], "platform": r["platform"], "excerpt": (r["excerpt"] or "")[:120],
                   "phrases": json.loads(r["headers"] or "{}").get("suspicious")}
                  for r in conn.execute("SELECT id, platform, excerpt, headers FROM source_event "
                                        "WHERE ignore_reason='suspicious' AND ingested_at > ?", (since,))]
    links = [{"item_ref": r["ref"], "title": r["title"], "system": r["system"], "sync_status": r["sync_status"]}
             for r in conn.execute("SELECT i.ref, i.title, l.system, l.sync_status FROM link l JOIN item i ON i.id=l.item_id "
                                   "WHERE l.sync_status IN ('conflict','missing') AND i.deleted_at IS NULL")]
    waiting = [_item(r) for r in conn.execute(
        "SELECT * FROM item WHERE deleted_at IS NULL AND status='waiting' AND (next_check_at IS NULL OR next_check_at <= ?)",
        (now_s,))]
    outbox = {"done_since_last": [], "awaiting_confirm": [], "pending": 0, "failed": []}
    for r in conn.execute("SELECT o.*, i.ref AS item_ref, i.title AS item_title FROM outbox o LEFT JOIN item i ON i.id=o.item_id "
                          "WHERE (o.status='done' AND o.done_at > ?) OR o.status IN ('awaiting_confirm','pending','failed') ORDER BY o.id",
                          (since,)):
        p = json.loads(r["payload"])
        entry = {"outbox_id": r["id"], "op": r["op"], "item_ref": r["item_ref"], "title": r["item_title"],
                 "summary": p.get("title") or p.get("external_key") or "", "last_error": r["last_error"]}
        if r["status"] == "done":
            outbox["done_since_last"].append(entry)
        elif r["status"] == "awaiting_confirm":
            outbox["awaiting_confirm"].append(entry)
        elif r["status"] == "failed":
            outbox["failed"].append(entry)
        else:
            outbox["pending"] += 1
    daily_unsynced = []
    for r in conn.execute("SELECT o.*, i.ref AS item_ref, i.title AS item_title FROM outbox o JOIN item i ON i.id=o.item_id "
                          "WHERE o.op='obsidian.daily_done' AND o.status IN ('pending','failed') ORDER BY o.id"):
        p = json.loads(r["payload"])
        daily_unsynced.append({"item_ref": r["item_ref"], "title": r["item_title"], "day": p.get("day"),
                               "state": ops._op_state(r), "attempts": r["attempts"], "last_error": r["last_error"]})
    checkins = [dict(r) for r in conn.execute("SELECT day, slot, created_at, answered_at, result FROM checkin "
                                             "WHERE day >= ? ORDER BY id", ((now - timedelta(days=1)).strftime("%Y-%m-%d"),))]
    sync = [dict(r) for r in conn.execute("SELECT * FROM sync_state ORDER BY platform, account")]
    stale = [s for s in sync if not s["last_success_at"] or s["last_success_at"] < d0]
    pending = {r["platform"]: r["c"] for r in conn.execute(
        "SELECT platform, COUNT(*) c FROM source_event WHERE triage='new' GROUP BY platform")}
    run = None
    if args.run:
        rr = conn.execute("SELECT * FROM run WHERE id=?", (args.run,)).fetchone()
        if rr:
            run = {"run_id": rr["id"], "kind": rr["kind"], "started_at": rr["started_at"], "delayed": bool(rr["delayed"]),
                   "steps": json.loads(rr["steps"] or "[]")}
    return {
        "now": now_s, "today": today, "weekday": "월화수목금토일"[now.weekday()], "run": run,
        "last_briefing_at": last_brief["sent_at"] if last_brief else None,
        "sync_state": sync, "stale_sources": stale, "pending_unprocessed": pending,
        "today_meetings": meetings, "today_overlay": overlays, "overlaps": day["overlaps"],
        "deadline_clusters": day["deadline_clusters"],
        "overdue": _overdue(conn, cfg, now_s),
        "imminent": _due_between(conn, cfg, d0, imminent_end),
        "new_items": new_items, "changed_items": changed, "captured": captured,
        "waiting_check": waiting, "questions": _open_questions(conn, now_s, due_now=True),
        "links_attention": links, "ignored_since_last": ignored, "suspicious": suspicious, "outbox": outbox,
        "approvals": ops.approval_queue(conn, cfg, now), "daily_unsynced": daily_unsynced, "checkins": checkins,
        "tracking": _tracking_summary(conn, cfg, now),
        "limits": {"section_limit": cfg["briefing"]["section_limit"], "imminent_days": cfg["briefing"]["imminent_days"]},
        "data_as_of": max([s["last_success_at"] or "" for s in sync] + [""]) or None,
    }


def _tracking_summary(conn, cfg, now) -> dict:
    """0.6.0 — 업무 현황(claire_buttons agenda)이 전체 목록을 맡는다. 브리핑에는 건수와 점검 결과만."""
    data = track.agenda_data(conn, cfg, now)
    h = track.health(conn, cfg, now)
    return {"counts": data["counts"], "check_refs": data["check_refs"], "exposure_gaps": h["exposure_gaps"],
            "delivery_issues": h["delivery"], "importance_unreviewed": h["importance_unreviewed"]}


def cmd_agenda(args, cfg):
    conn = _ctx(connect(create=False), cfg)
    now = now_dt(cfg)
    data = track.agenda_data(conn, cfg, now, overlays=_overlay_on(conn, cfg, now.strftime("%Y-%m-%d")))
    for key in ("today", "check", "upcoming"):
        for e in data[key]:
            e.pop("id", None)
    for sl in data["series"]:
        for e in sl["members"]:
            e.pop("id", None)
    for g in list(data["open"].values()) + list(data["parked"].values()):
        for e in g:
            e.pop("id", None)
    data["health"] = track.health(conn, cfg, now)
    data["data_as_of"] = _data_as_of(conn)
    return data


def cmd_report(args, cfg):
    conn = _ctx(connect(create=False), cfg)
    now = now_dt(cfg)
    d = track.report_data(conn, cfg, now, overlays=_overlay_on(conn, cfg, now.strftime("%Y-%m-%d")))

    def slim(e):
        return {k: e.get(k) for k in ("ref", "title", "kind", "status_label", "priority", "request_scope", "due_text",
                                      "when", "short_label", "project", "score", "waiting_on", "next_check_at")} | \
            {"check": e["check"].get("reason"), "keyword": track.keyword_of(e)}
    out = {"counts": d["counts"], "accounting": d["accounting"], "check_refs": d["check_refs"],
           "today_cal": [slim(e) for e in d["today_cal"]], "today_due": [slim(e) for e in d["today_due"]],
           "overlaps": d["overlaps"], "deadline_clusters": d["deadline_clusters"]}
    for key in ("overdue", "progress"):
        sec = d[key]
        out[key] = {"total": sec["total"], "detail": [slim(e) for e in sec["detail"]], "rest": [slim(e) for e in sec["rest"]],
                    "keyword_lines": sec["keywords"]["lines"], "omitted": sec["keywords"]["omitted"]}
    out.update(questions=d["questions"], done_refs=d["done_refs"], note_asks=d["note_asks"], labels_needed=d["labels_needed"],
               past_meetings=[slim(e) for e in d["past_meetings"]], parked=[slim(e) for e in d["parked"]],
               health=track.health(conn, cfg, now), data_as_of=_data_as_of(conn))
    return out


def cmd_labels_missing(args, cfg):
    """키워드 이름이 없는 활성 업무 (기한 지남·진행 확인 대상 먼저). Claire 가 1~3단어로 지어 claire_store labels 로 적는다."""
    conn = _ctx(connect(create=False), cfg)
    now = now_dt(cfg)
    d = track.report_data(conn, cfg, now)
    order = d["overdue"]["detail"] + d["overdue"]["rest"] + d["progress"]["detail"] + d["progress"]["rest"]
    seen, out = set(), []
    for e in order:
        if not e.get("short_label") and e["ref"] not in seen:
            seen.add(e["ref"])
            out.append({"ref": e["ref"], "title": e["title"], "project": e.get("project"),
                        "auto": track.auto_label(e["title"], track.label_stopwords(cfg))})
    total = conn.execute(f"SELECT COUNT(*) c FROM item WHERE deleted_at IS NULL AND {OPEN_SQL} AND "
                         "(short_label IS NULL OR short_label='')").fetchone()["c"]
    return {"items": out[:args.limit], "total_missing": total,
            "note": "제목·원문을 보고 업무를 알아볼 수 있는 1~3단어(20자 이내)로. 예: 'RiTA 회신', 'IROS 명단'. "
                    "'내 연구', '관련 요청', 사람 이름만 같은 것은 도구가 거부한다. 없으면 도구가 제목에서 고른다(auto)."}


def cmd_importance_review(args, cfg):
    """중요도 검토 필요 업무: 소급 분류로 잠정값만 있거나 요청 범위를 모르는 업무. 근거(받는 사람·발췌)를 함께 낸다.
    Claire 는 원문을 보고 `claire_store update --actor claire --item CLR --set request_scope=direct|group|self|none
    --set priority=high|normal --set priority_reason="..."` 로 확정한다. 교수님이 정한 중요도는 바꾸지 않는다."""
    conn = _ctx(connect(create=False), cfg)
    out = []
    # 직접 요청일 가능성이 큰 것부터: 회신 요청 → 잠정 높음 → 최근 (0.6.1). 소급 분류 전(NULL)도 포함.
    unrev = "(priority_source='unreviewed' OR priority_source IS NULL)"
    for r in conn.execute(f"SELECT * FROM item WHERE deleted_at IS NULL AND {unrev} AND {OPEN_SQL} "
                          "ORDER BY (kind='reply') DESC, (priority='high') DESC, id DESC LIMIT ?", (args.limit,)):
        d = _item(r)
        d["sources"] = []
        for e in conn.execute("SELECT e.platform, e.headers, e.excerpt FROM item_source s JOIN source_event e "
                              "ON e.id=s.source_event_id WHERE s.item_id=? AND s.role='origin' ORDER BY e.id LIMIT 2", (r["id"],)):
            h = json.loads(e["headers"] or "{}")
            d["sources"].append({"platform": e["platform"], "from": h.get("from"), "to": h.get("to"), "cc": h.get("cc"),
                                 "subject": h.get("subject"), "excerpt": (e["excerpt"] or "")[:300]})
        out.append(d)
    total = conn.execute(f"SELECT COUNT(*) c FROM item WHERE deleted_at IS NULL AND {unrev} AND {OPEN_SQL}").fetchone()["c"]
    return {"count": total, "items": out,
            "rule": "직접 요청(교수님을 특정한 회신·행동 요청) → high, 단체 공통 요청 → normal, 단체라도 개인 의무(결재·필수 제출) → high. "
                    "수신자 수만으로 정하지 않는다. 근거를 priority_reason 에."}


def cmd_today(args, cfg):
    conn = _ctx(connect(create=False), cfg)
    now = now_dt(cfg); day = args.date or now.strftime("%Y-%m-%d")
    d0, d1 = _day_bounds(cfg, day)
    if args.basis:
        out = {"date": day, "basis": args.basis, "data_as_of": _data_as_of(conn)}
        if args.basis == "due":
            out["items"] = _due_between(conn, cfg, d0, d1)
        elif args.basis == "scheduled":
            out["items"] = [_item(r) for r in conn.execute(
                f"SELECT * FROM item WHERE deleted_at IS NULL AND {OPEN_SQL} AND scheduled_on=? ORDER BY id", (day,))]
        elif args.basis == "completed":
            out["items"] = [_item(r) for r in conn.execute(
                "SELECT * FROM item WHERE deleted_at IS NULL AND status='done' AND completed_at >= ? AND completed_at <= ?", (d0, d1))]
        elif args.basis == "start":
            out["items"] = _meetings_on(conn, cfg, day)
        limit_days = int(cfg["obsidian"].get("completed_days", 90))
        if args.basis == "completed" and (now - datetime.strptime(day, "%Y-%m-%d").replace(tzinfo=tz_of(cfg))).days > limit_days:
            out["note"] = f"완료 이력 보존 범위({limit_days}일) 밖입니다. 결과가 불완전할 수 있습니다 (D2)"
        return out
    scheduled = [_item(r) for r in conn.execute(
        f"SELECT * FROM item WHERE deleted_at IS NULL AND {OPEN_SQL} AND scheduled_on=? ORDER BY id", (day,))]
    completed = [_item(r) for r in conn.execute(
        "SELECT * FROM item WHERE deleted_at IS NULL AND status='done' AND completed_at >= ? AND completed_at <= ?", (d0, d1))]
    meetings = _meetings_on(conn, cfg, day)
    return {"date": day, "basis": {"meetings": "start", "due": "due", "scheduled": "scheduled", "completed": "completed"},
            "meetings": meetings, "overlay": _overlay_on(conn, cfg, day), "due": _due_between(conn, cfg, d0, d1),
            "scheduled": scheduled, "completed": completed,
            "overdue": _overdue(conn, cfg, now.isoformat()) if day == now.strftime("%Y-%m-%d") else [],
            "data_as_of": _data_as_of(conn)}


def cmd_week(args, cfg):
    conn = _ctx(connect(create=False), cfg)
    now = now_dt(cfg); start_day = args.date or now.strftime("%Y-%m-%d")
    d0 = _day_bounds(cfg, start_day)[0]
    end_day = (datetime.strptime(start_day, "%Y-%m-%d") + timedelta(days=6)).strftime("%Y-%m-%d")
    d1 = _day_bounds(cfg, end_day)[1]
    meetings = []
    for i in range(7):
        day = (datetime.strptime(start_day, "%Y-%m-%d") + timedelta(days=i)).strftime("%Y-%m-%d")
        meetings += _meetings_on(conn, cfg, day)
    return {"from": start_day, "to": end_day, "basis": "due·start", "due": _due_between(conn, cfg, d0, d1),
            "meetings": meetings, "data_as_of": _data_as_of(conn)}


def cmd_overdue(args, cfg):
    conn = _ctx(connect(create=False), cfg)
    return {"basis": "due", "overdue": _overdue(conn, cfg, now_iso(cfg)), "data_as_of": _data_as_of(conn)}


def cmd_questions(args, cfg):
    conn = _ctx(connect(create=False), cfg)
    return {"questions": _open_questions(conn, now_iso(cfg), due_now=args.due_now)}


def cmd_show(args, cfg):
    conn = _ctx(connect(create=False), cfg)
    it = get_item(conn, args.item, allow_deleted=True)
    d = dict(it)
    d["sync"] = ops.sync_state_of(conn, it)
    d["state_line"] = ops.describe_state(conn, cfg, it)
    d["sources"] = [dict(r) for r in conn.execute(
        "SELECT s.role, e.id AS source_event_id, e.platform, e.account, e.event_ts, e.excerpt, e.triage "
        "FROM item_source s JOIN source_event e ON e.id=s.source_event_id WHERE s.item_id=? ORDER BY e.id", (it["id"],))]
    d["questions"] = [dict(r) for r in conn.execute("SELECT ref, field, question, status, answer FROM question WHERE item_id=?", (it["id"],))]
    d["links"] = [dict(r) for r in conn.execute("SELECT system, external_key, version, sync_status FROM link WHERE item_id=?", (it["id"],))]
    d["history"] = [dict(r) for r in conn.execute(
        "SELECT id, action, actor, field, old_value, new_value, reason, run_id, undone_at, created_at "
        "FROM activity_log WHERE item_id=? ORDER BY id", (it["id"],))]
    d["relations"] = [dict(r) for r in conn.execute(
        "SELECT rl.rel_type, a.ref AS from_ref, b.ref AS to_ref FROM relation rl JOIN item a ON a.id=rl.from_item_id "
        "JOIN item b ON b.id=rl.to_item_id WHERE rl.from_item_id=? OR rl.to_item_id=?", (it["id"], it["id"]))]
    return d


# --------------------------------------------------------------------------
# find / history / trace / waiting (3단계, §11)
# --------------------------------------------------------------------------

def cmd_find(args, cfg):
    """한국어 검색. Clio §7.1 가중합(제목·프로젝트·다음 행동·출처 발췌·FTS·최신성)을 항목에 맞게 적용."""
    conn = _ctx(connect(create=False), cfg)
    toks = tokenize(args.q)
    if not toks:
        raise ClaireError("empty_query", "검색어가 비어 있습니다")
    status_filter = args.status or "open"
    now = now_dt(cfg)
    half = max(1, int(cfg.get("recency_halflife_days", 30)))
    fts_raw = {}
    try:
        q = fts_query(toks)
        if q:
            for r in conn.execute("SELECT rowid AS rid, bm25(search_fts) AS b FROM search_fts WHERE search_fts MATCH ? LIMIT 300", (q,)):
                fts_raw[r["rid"]] = -float(r["b"])
    except sqlite3.OperationalError:
        fts_raw = {}
    fts_max = max(fts_raw.values()) if fts_raw else 0.0
    sql = "SELECT * FROM item WHERE deleted_at IS NULL"
    params = []
    if status_filter == "open":
        sql += f" AND {OPEN_SQL}"
    elif status_filter != "all":
        sql += " AND status=?"; params.append(status_filter)
    if args.project:
        sql += " AND project LIKE ?"; params.append(f"%{args.project}%")
    if args.since:
        sql += " AND updated_at >= ?"; params.append(args.since)
    if args.until:
        sql += " AND updated_at <= ?"; params.append(args.until + "T23:59:59+99:99")
    out = []
    for r in conn.execute(sql, params):
        title = unicodedata.normalize("NFC", r["title"] or "")
        proj = unicodedata.normalize("NFC", r["project"] or "")
        nxt = unicodedata.normalize("NFC", (r["next_action"] or "") + " " + (r["waiting_on"] or "") + " " + (r["done_criteria"] or ""))
        exc = unicodedata.normalize("NFC", " ".join(e["excerpt"] or "" for e in conn.execute(
            "SELECT s.excerpt FROM item_source i JOIN source_event s ON s.id=i.source_event_id WHERE i.item_id=? AND s.redacted_at IS NULL", (r["id"],))))
        h_title = [t for t in toks if hits(t, title)]
        h_proj = [t for t in toks if hits(t, proj)]
        h_next = [t for t in toks if hits(t, nxt)]
        h_exc = [t for t in toks if hits(t, exc)]
        n = len(toks)
        s_fts = (fts_raw.get(r["id"], 0.0) / fts_max) if fts_max > 0 else 0.0
        try:
            age = max(0.0, (now - parse_iso(r["updated_at"])).total_seconds() / 86400.0)
        except ValueError:
            age = 0.0
        score = (0.40 * len(h_title) / n + 0.15 * len(h_proj) / n + 0.15 * len(h_next) / n + 0.15 * len(h_exc) / n
                 + 0.10 * s_fts + 0.05 * 0.5 ** (age / half))
        if not (h_title or h_proj or h_next or h_exc or s_fts):
            continue
        d = _item(r)
        d["score"] = round(min(1.0, score), 4)
        d["matched"] = {"title": h_title, "project": h_proj, "next_action": h_next, "excerpt": h_exc, "fts": round(s_fts, 3)}
        out.append(d)
    out.sort(key=lambda x: (-x["score"], x["ref"]))
    return {"q": args.q, "tokens": toks, "status": status_filter, "count": len(out), "results": out[: args.limit],
            "data_as_of": _data_as_of(conn)}


def cmd_history(args, cfg):
    conn = _ctx(connect(create=False), cfg)
    it = get_item(conn, args.item, allow_deleted=True)
    rows = [dict(r) for r in conn.execute(
        "SELECT a.id, a.action, a.actor, a.field, a.old_value, a.new_value, a.reason, a.evidence_source_event_id, "
        "a.run_id, a.undone_at, a.created_at, e.platform, e.excerpt FROM activity_log a "
        "LEFT JOIN source_event e ON e.id=a.evidence_source_event_id WHERE a.item_id=? ORDER BY a.id", (it["id"],))]
    return {"ref": it["ref"], "title": it["title"], "status": it["status"], "history": rows}


def cmd_trace(args, cfg):
    """원문 역추적: source_event → 연결 항목 → 그 항목의 이력. 또는 항목 → 원문들."""
    conn = _ctx(connect(create=False), cfg)
    if args.source_event:
        ev = conn.execute("SELECT * FROM source_event WHERE id=?", (args.source_event,)).fetchone()
        if ev is None:
            raise ClaireError("source_event_not_found", f"source_event {args.source_event} 가 없습니다")
        items = []
        for r in conn.execute("SELECT i.*, s.role FROM item_source s JOIN item i ON i.id=s.item_id WHERE s.source_event_id=? ORDER BY i.id", (ev["id"],)):
            d = _item(r); d["role"] = r["role"]
            d["history"] = [dict(h) for h in conn.execute(
                "SELECT id, action, actor, field, old_value, new_value, reason, created_at, undone_at FROM activity_log "
                "WHERE item_id=? ORDER BY id", (r["id"],))]
            items.append(d)
        e = dict(ev); e["headers"] = json.loads(e.get("headers") or "{}")
        return {"source_event": {k: e.get(k) for k in ("id", "platform", "account", "external_id", "thread_id", "event_ts",
                                                          "ingested_at", "triage", "ignore_reason", "excerpt", "raw_path", "redacted_at")},
                "headers": {k: e["headers"].get(k) for k in ("subject", "from", "summary", "file", "line", "received_as", "suspicious") if k in e["headers"]},
                "items": items}
    it = get_item(conn, args.item, allow_deleted=True)
    srcs = [dict(r) for r in conn.execute(
        "SELECT s.role, e.id AS source_event_id, e.platform, e.account, e.external_id, e.thread_id, e.event_ts, e.excerpt, e.triage "
        "FROM item_source s JOIN source_event e ON e.id=s.source_event_id WHERE s.item_id=? ORDER BY e.id", (it["id"],))]
    return {"ref": it["ref"], "title": it["title"], "sources": srcs}


def cmd_waiting(args, cfg):
    conn = _ctx(connect(create=False), cfg)
    now_s = now_iso(cfg)
    sql = "SELECT * FROM item WHERE deleted_at IS NULL AND status='waiting'"
    params = []
    if args.who:
        sql += " AND waiting_on LIKE ?"; params.append(f"%{args.who}%")
    out = []
    for r in conn.execute(sql + " ORDER BY next_check_at", params):
        d = _item(r)
        last = conn.execute("SELECT created_at, reason FROM activity_log WHERE item_id=? AND action IN ('wait','update','progress') "
                            "ORDER BY id DESC LIMIT 1", (r["id"],)).fetchone()
        d["last_followup_at"] = last["created_at"] if last else None
        d["check_due"] = bool(r["next_check_at"] and r["next_check_at"] <= now_s)
        out.append(d)
    return {"who": args.who, "count": len(out), "waiting": out, "data_as_of": _data_as_of(conn)}


def cmd_dupcheck(args, cfg):
    """등록 전 중복 확인: 제목 어절이 겹치는 열린 항목, 최근 완료 항목, 같은 날짜의 항목을 근거와 함께 낸다.
    판단(같은 일인지)은 Claire 가 한다. 후보가 있으면 새로 만들지 말고 교수님께 확인한다."""
    conn = _ctx(connect(create=False), cfg)
    toks = tokenize(args.title)
    if not toks:
        raise ClaireError("empty_query", "제목이 비어 있습니다")
    now = now_dt(cfg)
    recent = (now - timedelta(days=int(args.recent_days))).isoformat()
    out = []
    for r in conn.execute("SELECT * FROM item WHERE deleted_at IS NULL AND (status NOT IN ('done','cancelled') "
                          "OR updated_at >= ?)", (recent,)):
        title = unicodedata.normalize("NFC", r["title"] or "")
        matched = [t for t in toks if hits(t, title)]
        days = {_local_day(r[c], cfg) for c in ("start_at", "due_at", "scheduled_on") if r[c]}
        same_day = bool(args.date and args.date in days)
        strong = len(matched) >= max(1, (len(toks) + 1) // 2)
        if not (strong or (same_day and matched)):
            continue
        d = _item(r)
        d["why"] = ", ".join(x for x in (f"제목 {len(matched)}/{len(toks)} 어절" if matched else "",
                                         "같은 날짜" if same_day else "") if x)
        d["score"] = len(matched) / len(toks) + (0.5 if same_day else 0)
        out.append(d)
    out.sort(key=lambda x: (-x["score"], x["ref"]))
    return {"title": args.title, "date": args.date, "candidates": out[:5], "count": len(out),
            "message": "중복 후보가 있습니다. 같은 일이면 새로 만들지 말고 번호를 알려 드리세요." if out else "중복 후보 없음"}


def _data_as_of(conn):
    r = conn.execute("SELECT MAX(last_success_at) m FROM sync_state").fetchone()
    return r["m"] if r else None


def build_parser():
    p = argparse.ArgumentParser(prog="claire_search", description="Claire 조회 (DB만 읽음)")
    sub = p.add_subparsers(dest="cmd")
    r = sub.add_parser("review"); r.add_argument("--run", type=int); r.set_defaults(fn=cmd_review)
    t = sub.add_parser("today"); t.add_argument("--date")
    t.add_argument("--basis", choices=["due", "scheduled", "completed", "start"]); t.set_defaults(fn=cmd_today)
    f = sub.add_parser("find"); f.add_argument("--q", required=True); f.add_argument("--status", default="open")
    f.add_argument("--project"); f.add_argument("--since"); f.add_argument("--until"); f.add_argument("--limit", type=int, default=10)
    f.set_defaults(fn=cmd_find)
    h = sub.add_parser("history"); h.add_argument("--item", required=True); h.set_defaults(fn=cmd_history)
    tr = sub.add_parser("trace"); tr.add_argument("--source-event", type=int); tr.add_argument("--item"); tr.set_defaults(fn=cmd_trace)
    wt = sub.add_parser("waiting"); wt.add_argument("--who"); wt.set_defaults(fn=cmd_waiting)
    w = sub.add_parser("week"); w.add_argument("--date"); w.set_defaults(fn=cmd_week)
    o = sub.add_parser("overdue"); o.set_defaults(fn=cmd_overdue)
    q = sub.add_parser("questions"); q.add_argument("--due-now", action="store_true"); q.set_defaults(fn=cmd_questions)
    s = sub.add_parser("show"); s.add_argument("--item", required=True); s.set_defaults(fn=cmd_show)
    dc = sub.add_parser("dupcheck", help="등록 전 중복 후보")
    dc.add_argument("--title", required=True); dc.add_argument("--date", help="YYYY-MM-DD (일정·마감 날짜)")
    dc.add_argument("--recent-days", type=int, default=14, help="완료·취소 항목은 최근 N일 안에 바뀐 것만")
    dc.set_defaults(fn=cmd_dupcheck)
    ag = sub.add_parser("agenda", help="업무 현황 재료 (0.6.0)"); ag.set_defaults(fn=cmd_agenda)
    ir = sub.add_parser("importance-review", help="중요도 검토 필요 업무 (0.6.0)")
    ir.add_argument("--limit", type=int, default=20); ir.set_defaults(fn=cmd_importance_review)
    rp = sub.add_parser("report", help="아침 보고 재료 (0.7.0)"); rp.set_defaults(fn=cmd_report)
    lm = sub.add_parser("labels-missing", help="키워드 이름 없는 활성 업무 (0.7.0)")
    lm.add_argument("--limit", type=int, default=40); lm.set_defaults(fn=cmd_labels_missing)
    return p


if __name__ == "__main__":
    run_cli(build_parser, lambda args, cfg: args.fn(args, cfg))
